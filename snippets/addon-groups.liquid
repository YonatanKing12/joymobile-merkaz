{% doc %}
  The accessory groups that fit a device, from the theme setting "כללים לאביזרים משלימים"
  (settings.addon_rules; theme settings › אביזרים משלימים). One rule per line (or separated by ";"):

    <product type> | <tab label> | <search word> | <what follows the word>

  where what follows is דגם (the model from the title, snippets/accessory-model), שעון (the watch
  model and case size), יצרן (the brand, product.vendor) or ללא (nothing). Rules apply to products
  whose type is exactly the first column, in the order written. An empty setting means the built-in
  rules below, which are what the store has always used.

  Echoes "###<label>|<word>|<query>" per group. A דגם / שעון group is left out when the title yields
  no model, so no tab ever asks for a bare "כיסוי". A יצרן group with no brand (or the store itself
  as vendor) keeps the word alone; the caller decides whether a bare word is worth asking for (the
  product page shows generic chargers, the cart skips it).

  Shared by snippets/product-addons (every group, as tabs) and snippets/cart-upsell (the first two
  groups that name a model or a brand), so the product page and the cart never disagree.

  @param {product} product - The device.

  @example
  {%- capture groups -%}{%- render 'addon-groups', product: product -%}{%- endcapture -%}
{% enddoc %}
{%- assign ag_verified = product.metafields.custom.joy_addon_groups.value -%}
{%- if ag_verified.version == 1 -%}
  {%- for ag_group in ag_verified.groups -%}
    {%- liquid
      assign ag_prefix = ag_group.tag | slice: 0, 11
      if ag_prefix == 'joy-fit-v1-' and ag_group.label != blank and ag_group.word != blank
        echo '###' | append: ag_group.label | append: '|' | append: ag_group.word | append: '|tag:' | append: ag_group.tag
      endif
    -%}
  {%- endfor -%}
{%- else -%}
{%- liquid
  assign ag_rules = settings.addon_rules | strip
  if ag_rules == blank
    assign ag_rules = 'מכשירים|כיסויים|כיסוי|דגם;מכשירים|מגני מסך|מגן מסך|דגם;מכשירים|מטענים|מטען|יצרן;מכשירים|סוללות גיבוי|סוללה ניידת|ללא;טאבלטים|כיסויים|כיסוי|דגם;טאבלטים|מגני מסך|מגן מסך|דגם;טאבלטים|מטענים|מטען|יצרן;טאבלטים|כבלים|כבל|יצרן;שעונים|רצועות|רצועה|שעון;שעונים|מגני מסך|מגן מסך|שעון;שעונים|מטענים|מטען|יצרן;אוזניות|כיסויים|כיסוי|דגם;אוזניות|מטענים|מטען|יצרן;אוזניות|כבלים|כבל|יצרן'
  endif
  assign ag_lines = ag_rules | newline_to_br | replace: '<br />', ';' | split: ';'

  assign ag_type = product.type | strip
  assign ag_match = false
  for ag_line in ag_lines
    assign ag_first = ag_line | split: '|' | first | strip
    if ag_first == ag_type
      assign ag_match = true
      break
    endif
  endfor
-%}
{%- if ag_match -%}
  {%- capture ag_model -%}{%- render 'accessory-model', product: product -%}{%- endcapture -%}
  {%- capture ag_watch -%}{%- render 'accessory-model', product: product, mode: 'watch' -%}{%- endcapture -%}
  {%- liquid
    assign ag_model = ag_model | strip
    assign ag_watch = ag_watch | strip
    # The shop's own name as vendor ("joy mobile" on 236 products, "Joy Mobile Merkaz" on some of
    # Eilat's) is not a brand.
    assign ag_vendor = product.vendor | strip
    assign ag_vendor_key = ag_vendor | downcase
    assign ag_vendor_house = ag_vendor_key | slice: 0, 10
    assign ag_house = shop.name | strip | downcase
    assign ag_brand = settings.brand_name | strip | downcase
    if ag_vendor_key == ag_house or ag_vendor_key == ag_brand or ag_vendor_house == 'joy mobile'
      assign ag_vendor = ''
    endif

    # Wireless charging, from the model: every iPhone the store sells (MagSafe from the 12), Galaxy S, Z and
    # Note, every Pixel, Xiaomi's numbered flagships ("Xiaomi 17") and OnePlus's ("OnePlus 15", not "15R"
    # or Nord). Galaxy A, Redmi, POCO and the rest charge by cable only (or are not known to), so a power
    # bank group for them leaves out the magnetic and wireless ones (snippets/accessory-fit).
    assign ag_wireless = false
    assign ag_model_key = ag_model | downcase
    assign ag_model_words = ag_model_key | split: ' '
    assign ag_model_second = ag_model_words[1] | default: ''
    assign ag_lead6 = ag_model_key | slice: 0, 6
    assign ag_lead8 = ag_model_key | slice: 0, 8
    assign ag_lead11 = ag_model_key | slice: 0, 11
    if ag_lead6 == 'iphone' or ag_lead8 == 'galaxy s' or ag_lead8 == 'galaxy z' or ag_lead11 == 'galaxy note' or ag_lead6 == 'pixel '
      assign ag_wireless = true
    elsif ag_model_words.first == 'xiaomi' or ag_model_words.first == 'oneplus'
      assign ag_second_digits = ag_model_second | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
      if ag_model_second != '' and ag_second_digits == ''
        assign ag_wireless = true
      endif
    endif

    # An Apple Watch is charged by its own puck, not by a phone's charger: the watch's charger group asks for
    # "טעינה Apple Watch" (the store's "כבל טעינה Apple MagSafe ל-Apple Watch"), the family without the case
    # size, and a watch with no maker in its model gets none.
    assign ag_watch_family = ag_watch
    assign ag_watch_last = ag_watch | split: ' ' | last
    assign ag_watch_last_digits = ag_watch_last | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
    if ag_watch_last != blank and ag_watch_last_digits == ''
      assign ag_watch_family = ag_watch | remove_last: ag_watch_last | strip
    endif

    for ag_line in ag_lines
      assign ag_parts = ag_line | split: '|'
      if ag_parts.size < 3
        continue
      endif
      assign ag_rule_type = ag_parts[0] | strip
      if ag_rule_type != ag_type
        continue
      endif
      assign ag_label = ag_parts[1] | strip
      assign ag_word = ag_parts[2] | strip
      assign ag_kind = ag_parts[3] | strip
      if ag_label == blank or ag_word == blank
        continue
      endif
      case ag_kind
        when 'דגם'
          if ag_model == blank
            continue
          endif
          assign ag_query = ag_word | append: ' ' | append: ag_model
        when 'שעון'
          if ag_watch == blank
            continue
          endif
          assign ag_query = ag_word | append: ' ' | append: ag_watch
        when 'יצרן'
          assign ag_query = ag_word
          if ag_vendor != blank
            assign ag_query = ag_word | append: ' ' | append: ag_vendor
          endif
          if ag_type == 'שעונים' and ag_word == 'מטען'
            assign ag_family_key = ag_watch_family | downcase
            unless ag_family_key contains ' watch' or ag_family_key contains 'xwatch'
              continue
            endunless
            assign ag_query = 'טעינה ' | append: ag_watch_family
          endif
        else
          assign ag_query = ag_word
      endcase

      # Power banks are for phones (and for tablets when a rule asks for them), never headphones or
      # watches; a phone without wireless charging is not offered the magnetic or wireless ones.
      if ag_word == 'סוללה ניידת'
        unless ag_type == 'מכשירים' or ag_type == 'טאבלטים'
          continue
        endunless
        unless ag_wireless
          assign ag_query = ag_query | append: ' -Magnetic -Magnet -MagSafe -Wireless'
        endunless
      endif
      echo '###' | append: ag_label | append: '|' | append: ag_word | append: '|' | append: ag_query
    endfor
  -%}
{%- endif -%}

{%- endif -%}
