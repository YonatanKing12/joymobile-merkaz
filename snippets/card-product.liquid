{% doc %}
  Product card: a rounded white card with a soft image well (white-background photos blend
  into it), the badges and the wishlist heart over the image, the brand name, a two-line
  title, colour dots when the product has several colours, the Eilat price, a stock line
  and ONE full-width "שריון באילת" button. Hover: the card lifts, the image zooms slowly
  (off for reduced motion) and the button turns green.

  The title link stretches over the whole card, so each card is one tab stop plus the heart
  and the button, which sit above the stretched link.
  - Single-variant product: a tiny /cart/add form inside <product-form data-mode="cart">
    (@theme/product) — with JS it reserves through AJAX and opens the cart drawer; without JS
    (or before product.js loads) the form posts and lands on /cart.
  - Multi-variant product: the button is a link to the product page (label unchanged).
  - Sold out: a disabled "אזל מהמלאי" button.

  Brand: the vendor name above the title (theme setting "הצגת המותג"); nothing when the vendor
  is the store itself. A product without a photo shows its brand logo in the image well —
  the file `brand-<vendor handle>.png` from the store's Files (Content › Files, e.g.
  brand-apple.png) — or the JOY Mobile symbol when there is no such file.

  Stock line: "במלאי", or "נותרו N יחידות" / "יחידה אחרונה" when the variant tracks inventory
  and has at most `settings.badge_low_stock_threshold` units (default 2).

  The caller wraps the card (list item / carousel slide) and links, once per section:
  component-card.css, component-price.css, component-badges.css, component-swatches.css,
  component-wishlist-button.css, plus `<script type="module" src="{{ 'product.js' | asset_url }}">`
  for the AJAX reserve button.

  @param {product} product - The product.
  @param {boolean} [lazy] - Lazy-load the images. Default true; pass false for the first cards above the fold.
  @param {string} [heading] - Tag of the title: 'h2', 'h3' (default) or 'h4'.
  @param {string} [section_id] - The calling section's id; keeps element ids unique when a product appears in several sections.
  @param {boolean} [show_swatches] - Colour dots. Default: the theme setting "עיגולי צבע".

  @example
  {% render 'card-product', product: product, lazy: true, heading: 'h3', section_id: section.id, show_swatches: true %}
{% enddoc %}
{%- liquid
  assign card_heading = 'h3'
  if heading == 'h2' or heading == 'h4'
    assign card_heading = heading
  endif

  assign card_loading = 'lazy'
  if lazy == false
    assign card_loading = 'eager'
  endif

  assign card_swatches = settings.card_show_swatches
  if show_swatches == false
    assign card_swatches = false
  elsif show_swatches == true
    assign card_swatches = true
  endif

  assign card_uid = section_id | default: 'card' | append: '-' | append: product.id
  assign card_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign card_url = product.url | within: collection

  assign card_image = product.featured_media.preview_image
  assign card_image_2 = nil
  if settings.card_show_secondary_image and product.media.size > 1
    assign card_image_2 = product.media[1].preview_image
  endif

  assign card_sizes = '(min-width: 1200px) 320px, (min-width: 768px) 30vw, 50vw'

  assign card_vendor = product.vendor | strip
  assign card_brand_logo = nil
  if card_vendor != blank and card_vendor != shop.name
    if card_image == blank
      assign card_brand_file = card_vendor | handleize | prepend: 'brand-' | append: '.png'
      assign card_brand_logo = images[card_brand_file]
    endif
  else
    assign card_vendor = ''
  endif

  assign card_stock = ''
  assign card_stock_count = 0
  if product.available
    assign card_stock = 'in'
    assign card_low_threshold = settings.badge_low_stock_threshold | default: 2
    if card_variant.inventory_management == 'shopify' and card_variant.inventory_quantity > 0 and card_variant.inventory_quantity <= card_low_threshold
      assign card_stock = 'low'
      assign card_stock_count = card_variant.inventory_quantity
    endif
  endif

  assign card_single = false
  if product.has_only_default_variant or product.variants.size == 1
    assign card_single = true
  endif

  assign card_classes = 'card-product'
  if settings.card_image_fit == 'cover'
    assign card_classes = card_classes | append: ' card-product--cover'
  endif
  if card_image_2 != nil
    assign card_classes = card_classes | append: ' card-product--has-second'
  endif
  unless product.available
    assign card_classes = card_classes | append: ' card-product--sold-out'
  endunless
-%}
<div class="{{ card_classes }}">
  <div class="card-product__media">
    {%- if card_image != blank -%}
      {%- render 'image',
        image: card_image,
        widths: '220,330,440,660',
        sizes: card_sizes,
        loading: card_loading,
        decorative: true,
        class: 'card-product__img'
      -%}
      {%- if card_image_2 != nil -%}
        {%- render 'image',
          image: card_image_2,
          widths: '220,330,440,660',
          sizes: card_sizes,
          loading: 'lazy',
          decorative: true,
          class: 'card-product__img card-product__img--second'
        -%}
      {%- endif -%}
    {%- elsif card_brand_logo != blank -%}
      <div class="card-product__placeholder card-product__placeholder--brand">
        {%- render 'image',
          image: card_brand_logo,
          widths: '135,270',
          sizes: '135px',
          loading: card_loading,
          decorative: true,
          class: 'card-product__placeholder-logo'
        -%}
      </div>
    {%- else -%}
      <div class="card-product__placeholder">
        <img
          class="card-product__placeholder-logo"
          src="{{ 'logo-joy-symbol.png' | asset_url }}"
          alt=""
          width="361"
          height="472"
          loading="lazy"
        >
      </div>
    {%- endif -%}

    {%- render 'badges', product: product, context: 'card', class: 'card-product__badges' -%}
    {%- render 'wishlist-button', product: product, class: 'card-product__wishlist', size: 20 -%}
  </div>

  <div class="card-product__body">
    {%- if settings.card_show_vendor and card_vendor != blank -%}
      <p class="card-product__vendor">{{ card_vendor | escape }}</p>
    {%- endif -%}

    <{{ card_heading }} class="card-product__title">
      <a class="card-product__link" href="{{ card_url }}">{{ product.title | escape }}</a>
    </{{ card_heading }}>

    {%- if card_swatches -%}
      {%- render 'swatches', product: product, limit: settings.card_swatch_limit, class: 'card-product__swatches' -%}
    {%- endif -%}

    <div class="card-product__footer">
      {%- render 'price', product: product, context: 'card', class: 'card-product__price' -%}

      {%- if card_stock != blank -%}
        <p class="card-product__stock card-product__stock--{{ card_stock }}">
          {%- if card_stock == 'low' -%}
            {%- if card_stock_count == 1 -%}
              {{- 'products.card.stock_last' | t -}}
            {%- else -%}
              {{- 'products.card.stock_low' | t: count: card_stock_count -}}
            {%- endif -%}
          {%- else -%}
            {{- 'products.card.stock_in' | t -}}
          {%- endif -%}
        </p>
      {%- endif -%}

      <div class="card-product__actions">
        {%- if product.available == false -%}
          <button class="button card-product__button" type="button" disabled>
            {{- 'products.card.sold_out' | t -}}
            <span class="visually-hidden">: {{ product.title | escape }}</span>
          </button>
        {%- elsif card_single -%}
          <product-form class="card-product__form" data-mode="cart">
            <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8">
              <input type="hidden" name="id" value="{{ card_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button class="button card-product__button" type="submit" aria-describedby="CardError-{{ card_uid }}">
                {%- render 'icon', name: 'bag', size: 18, class: 'card-product__button-icon' -%}
                <span>
                  {{- 'products.card.reserve' | t -}}
                  <span class="visually-hidden">: {{ product.title | escape }}</span>
                </span>
              </button>
              <p class="card-product__error" id="CardError-{{ card_uid }}" data-form-error hidden></p>
            </form>
          </product-form>
        {%- else -%}
          <a class="button card-product__button" href="{{ card_url }}">
            {%- render 'icon', name: 'bag', size: 18, class: 'card-product__button-icon' -%}
            <span>
              {{- 'products.card.reserve' | t -}}
              <span class="visually-hidden">: {{ product.title | escape }}</span>
            </span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
