{% doc %}
  Every JOY Mobile location in Eilat as a schema.org store (snippets/branch-json.liquid),
  printed as comma-separated JSON objects for the `department` list of the Organization on
  the home page (snippets/structured-data, type 'organization'). A search engine or an AI
  assistant that reads only the home page still learns every branch, its address, phone
  and opening hours.

  Source: the "branch" metaobject (Admin › תוכן › מטא-אובייקטים › סניף), the same entries
  the branches page shows (sections/branches.liquid), in their "סדר הצגה" order
  (snippets/branch-order.liquid); the @ids are the entries' handles (branch-flagship…), the
  same nodes the branches page prints. Only when the store has no active entry are the five
  branches below printed instead: a frozen copy of the branch blocks of
  templates/page.branches.json, kept so the home page never loses its stores.

  @example
  "department": [{% render 'branches-json' %}]
{% enddoc %}
{%- liquid
  assign bl_page_url = ''
  if settings.branches_page != blank
    assign bl_page_url = request.origin | append: settings.branches_page.url
  endif

  capture bl_order
    render 'branch-order'
  endcapture
  assign bl_order = bl_order | split: ','
  assign bl_count = 0
-%}
{%- if bl_order.size > 0 -%}
  {%- for bl_position in bl_order -%}
    {%- assign bl_index = bl_position | plus: 0 -%}
    {%- for bl_entry in metaobjects.branch.values -%}
      {%- if forloop.index0 == bl_index and bl_entry.name.value != blank and bl_entry.address.value != blank -%}
        {%- if bl_count > 0 -%},{%- endif -%}
        {%- assign bl_count = bl_count | plus: 1 -%}
        {%- render 'branch-json',
          id: bl_entry.system.handle,
          name: bl_entry.name.value,
          services: bl_entry.services.value,
          address: bl_entry.address.value,
          phone: bl_entry.phone.value,
          hours_spec: bl_entry.hours_spec.value,
          geo: bl_entry.geo.value,
          map_query: bl_entry.map_query.value,
          image: bl_entry.image.value.preview_image,
          page_url: bl_page_url
        -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- else -%}
{%- render 'branch-json',
  id: 'branch-flagship',
  name: 'סניף הדגל – טיילת אילת',
