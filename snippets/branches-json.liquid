  address: 'דרבן 150, פנינת אילת (מול מול הים), אילת',
  phone: '03-511-7171',
  hours_spec: 'Su-Th 10:00-23:00; Fr 10:00-14:00',
  map_query: 'JOY Mobile, דרבן 150, אילת',
