{% doc %}
  "דרופשיפינג" product page card, under the buy buttons (sections/main-product, buy_buttons block). Nothing is
  printed for any other product (snippets/dropship decides, by `custom.dropship_days` or the tag).

  - The way to the customer as three steps: "מזמינים היום" → "יוצא מהספק" → "אצלך עד <date>". The server prints
    "עד X ימי עסקים"; assets/dropship-pdp.js turns it into the date, counting business days (Sunday to Thursday,
    without the holidays listed in the block setting) from today in Israel.
  - One line on who ships it (the block's text), then rows that print only with data behind them:
    installments (the variant's price over the free count), the warranty (`custom.warranty_months` and the import
    channel, as in snippets/product-trust) and, for PC parts, free assembly in the PC builder.
  - A quiet strip of three facts: secure payment, tax invoice, WhatsApp.
  - PC parts: "נתונים עיקריים" chips read from the title by assets/pc-builder-parser.js (the PC builder's parser;
    only facts the title states), filled by the script; the box stays hidden when the title gives nothing.

  Styles: assets/component-dropship-pdp.css. Script: assets/dropship-pdp.js (both linked here).

  @param {product} product - The product.
  @param {variant} variant - The selected variant.
  @param {object} block - The buy_buttons block (its dropship_* settings).

  @example
  {% render 'dropship-pdp', product: product, variant: current_variant, block: block %}
{% enddoc %}
{%- liquid
  capture dsp_days
    render 'dropship', product: product, part: 'days'
  endcapture
  assign dsp_days = dsp_days | strip
-%}
{%- if dsp_days != blank -%}
  {%- liquid
    assign dsp_variant = variant | default: product.selected_or_first_available_variant

    # Installments: the free count's monthly amount, rounded up to a whole shekel.
    assign dsp_free = block.settings.dropship_installments_free | default: 0 | floor
    assign dsp_max = block.settings.dropship_installments_max | default: 0 | floor
    assign dsp_each = ''
    if dsp_free > 1 and dsp_variant.price > 0
      assign dsp_each = dsp_variant.price | divided_by: 100.0 | divided_by: dsp_free | ceil | times: 100 | money_without_trailing_zeros
    endif

    # Warranty: the months, then the import channel (the same source as snippets/product-trust).
    assign dsp_months = dsp_variant.metafields.custom.warranty_months.value | default: product.metafields.custom.warranty_months.value
    capture dsp_channel
      render 'import-channel', product: product
    endcapture
    assign dsp_channel = dsp_channel | strip

    # PC parts: the builder's collection or the product type.
    assign dsp_pc = false
    assign dsp_collections = product.collections | map: 'handle'
    if dsp_collections contains 'pc-builder-parts' or product.type == 'רכיבי מחשב'
      assign dsp_pc = true
    endif
    assign dsp_pc_url = block.settings.dropship_pc_link | default: pages['pc-builder'].url | default: '/pages/pc-builder'

    # WhatsApp with the product, as the trust box's link (snippets/product-trust).
    assign dsp_wa_text = settings.contact_whatsapp_message | strip
    if dsp_wa_text != blank
      assign dsp_wa_text = dsp_wa_text | append: ' — '
    endif
    assign dsp_wa_text = dsp_wa_text | append: product.title | append: ' ' | append: request.origin | append: product.url
    capture dsp_wa_url
      render 'whatsapp-url', text: dsp_wa_text
    endcapture
    assign dsp_wa_url = dsp_wa_url | strip

    assign dsp_holidays = block.settings.dropship_holidays | newline_to_br | replace: '<br />', ',' | strip_newlines | remove: ' '
  -%}
  {{ 'component-dropship-pdp.css' | asset_url | stylesheet_tag }}
  <script type="module" src="{{ 'dropship-pdp.js' | asset_url }}"></script>

  <div
    class="dsp"
    data-dropship-pdp
    data-days="{{ dsp_days | escape }}"
    data-holidays="{{ dsp_holidays | escape }}"
  >
    <ol class="dsp-steps" role="list" aria-label="{{ 'dropship.pdp.steps_label' | t }}">
      <li class="dsp-step dsp-step--now">
        <span class="dsp-step__dot" aria-hidden="true"></span>
        <span class="dsp-step__label">{{ 'dropship.pdp.step_order' | t }}</span>
      </li>
      <li class="dsp-step">
        <span class="dsp-step__dot" aria-hidden="true"></span>
        <span class="dsp-step__label">{{ 'dropship.pdp.step_ship' | t }}</span>
      </li>
      <li class="dsp-step dsp-step--end">
        <span class="dsp-step__dot" aria-hidden="true"></span>
        <span class="dsp-step__label">
          {{- 'dropship.pdp.step_arrive' | t -}}
          <strong class="dsp-step__date" data-dsp-date>{{ 'dropship.pdp.days' | t: days: dsp_days }}</strong>
        </span>
      </li>
    </ol>

    {%- if block.settings.dropship_source_text != blank -%}
      <p class="dsp-source">
        <svg class="dsp-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="m12 2.75 8.25 4.5v9.5L12 21.25l-8.25-4.5v-9.5z"/><path d="M3.75 7.25 12 11.75l8.25-4.5M12 11.75v9.5M7.9 5 16.1 9.5"/>
        </svg>
        <span>{{ block.settings.dropship_source_text | escape }}</span>
      </p>
    {%- endif -%}

    <ul class="dsp-rows" role="list">
      <li class="dsp-row" data-swap="dropship-pay"{% if dsp_each == blank %} hidden{% endif %}>
        {%- render 'icon', name: 'credit-card', size: 20, class: 'dsp-icon' -%}
        <span class="dsp-row__text">
          <strong>{{ 'dropship.pdp.installments' | t: count: dsp_free }}</strong>
          <span class="dsp-row__sep" aria-hidden="true">·</span>
          <span class="dsp-row__nowrap">{{ 'dropship.pdp.per_month' | t: amount: dsp_each }}</span>
          {%- if dsp_max > dsp_free %}
            <span class="dsp-row__note">{{ 'dropship.pdp.installments_max' | t: count: dsp_max }}</span>
          {%- endif -%}
        </span>
      </li>
      {%- if dsp_months != blank or dsp_channel != blank -%}
        <li class="dsp-row">
          {%- render 'icon', name: 'shield', size: 20, class: 'dsp-icon' -%}
          <span class="dsp-row__text">
            {%- if dsp_months != blank -%}
              {%- assign dsp_months_text = 'products.product.warranty_months' | t: count: dsp_months -%}
              <strong>{{ 'dropship.pdp.warranty' | t: months: dsp_months_text }}</strong>
            {%- endif -%}
            {%- if dsp_months != blank and dsp_channel != blank %}
              <span class="dsp-row__sep" aria-hidden="true">·</span>
            {% endif -%}
            {{- dsp_channel | escape -}}
          </span>
        </li>
      {%- endif -%}
      {%- if dsp_pc -%}
        <li class="dsp-row dsp-row--link">
          <a class="dsp-row__link" href="{{ dsp_pc_url }}">
            <svg class="dsp-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="6" y="2.5" width="12" height="19" rx="2"/><path d="M9 6h4M9 8.5h4"/><circle cx="12" cy="15" r="3"/>
            </svg>
            <span class="dsp-row__text">
              {{- 'dropship.pdp.assembly_lead' | t }} <strong>{{ 'dropship.pdp.assembly' | t }}</strong>
            </span>
            {%- render 'icon', name: 'chevron-left', size: 16, class: 'dsp-row__chevron' -%}
          </a>
        </li>
      {%- endif -%}
    </ul>

    <ul class="dsp-trust" role="list">
      <li>{%- render 'icon', name: 'lock', size: 16, class: 'dsp-trust__icon' -%}{{ 'dropship.pdp.trust_secure' | t }}</li>
      <li>
        <svg class="dsp-trust__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M6 2.75h12v18.5l-2-1.25-2 1.25-2-1.25-2 1.25-2-1.25-2 1.25z"/><path d="M9 7.5h6M9 11h6M9 14.5h3.5"/>
        </svg>
        {{- 'dropship.pdp.trust_invoice' | t -}}
      </li>
      {%- if dsp_wa_url != blank -%}
        <li>
          <a class="dsp-trust__link" href="{{ dsp_wa_url }}" target="_blank" rel="noopener">
            {%- render 'icon', name: 'whatsapp', size: 16, class: 'dsp-trust__icon' -%}
            {{- 'dropship.pdp.trust_whatsapp' | t -}}
            <span class="visually-hidden">{{ 'general.new_window' | t }}</span>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </div>

  {%- if dsp_pc -%}
    <div class="dsp-facts" data-dropship-facts data-title="{{ product.title | escape }}" data-parser-src="{{ 'pc-builder-parser.js' | asset_url }}" hidden>
      <h3 class="dsp-facts__title">{{ 'dropship.pdp.facts' | t }}</h3>
      <ul class="dsp-facts__list" role="list"></ul>
    </div>
  {%- endif -%}
{%- endif -%}
