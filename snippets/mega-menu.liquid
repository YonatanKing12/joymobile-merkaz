{% doc %}
  Desktop navigation bar (≥992px): the store menu (up to 3 levels) as one centred row.
  Each item with children opens a white panel (snippets/mega-menu-panel). Inside a panel the
  second-level items are groups: a green title over its links (snippets/mega-menu-group), one
  group per column, so the groups sit side by side instead of stacking. A department with
  several groups gets a wide panel centred under the bar, sized to its columns, with an
  optional featured tile; a department with one group keeps the small panel that hangs from
  its item. Many groups switch to tabs inside the panel (header setting "פריסת התפריט").

  Markup contract with <header-menu> (@theme/header): one `<details>` per top-level item
  with children, summary first. Works without JS; JS adds 150ms hover intent (mouse), one
  open panel at a time, Escape (focus back on the item), outside click, focus-out, keeps
  `aria-expanded` on the summary in sync, and drives the "עוד" buttons and the tabs.

  @param {linklist} menu - The menu to render (e.g. section.settings.menu).
  @param {string} [id_prefix] - Prefix for element ids. Default 'HeaderMenu'.
  @param {number} [group_limit] - Links a group shows before its "עוד" button. Default 7.
  @param {string} [layout] - 'auto' (default), 'columns' or 'tabs'.
  @param {number} [tabs_from] - With 'auto': tabs from this many columns. Default 5.
  @param {boolean} [show_feature] - Featured tile in wide panels. Default true.
  @param {object} [promos] - The header section's blocks; 'mega_promo' blocks replace the featured tile.

  @example
  {% render 'mega-menu', menu: section.settings.menu, id_prefix: 'HeaderMenu', promos: section.blocks %}
{% enddoc %}
{%- liquid
  assign menu_prefix = id_prefix | default: 'HeaderMenu'
  assign mm_limit = group_limit | default: 7
  assign mm_layout = layout | default: 'auto'
  assign mm_tabs_from = tabs_from | default: 5
  assign mm_feature = true
  if show_feature == false
    assign mm_feature = false
  endif
-%}
{%- if menu.links.size > 0 -%}
  <header-menu class="mega-menu">
    <ul class="mega-menu__list" role="list">
      {%- for link in menu.links -%}
        {%- liquid
          assign top_active = false
          if link.active or link.child_active
            assign top_active = true
          endif
          assign half = forloop.length | divided_by: 2
          assign panel_side = 'start'
          if forloop.index > half
            assign panel_side = 'end'
          endif
          assign panel_id = menu_prefix | append: '-' | append: forloop.index
        -%}
        {%- if link.links.size > 0 -%}
          {%- render 'mega-menu-panel',
            link: link,
            panel_id: panel_id,
            side: panel_side,
            active: top_active,
            group_limit: mm_limit,
            layout: mm_layout,
            tabs_from: mm_tabs_from,
            show_feature: mm_feature,
            promos: promos
          -%}
        {%- else -%}
          <li class="mega-menu__item">
            <a class="mega-menu__top{% if top_active %} is-active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
              <span class="mega-menu__label" data-text="{{ link.title | escape }}">{{ link.title | escape }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </header-menu>
{%- endif -%}
