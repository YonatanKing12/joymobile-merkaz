{%- liquid
  assign ssm_lines = ssm_pairs | newline_to_br | split: '<br />'
  for ssm_line in ssm_lines
    assign ssm_pair = ssm_line | strip | split: ' '
    if ssm_pair[0] == handle and ssm_pair[1] != blank
      echo ssm_pair[1]
      break
    endif
  endfor
-%}
