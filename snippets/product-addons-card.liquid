{% doc %}
  One accessory card, shared by direct verified recommendations and legacy search results.
  @param {product} accessory - The accessory; its available variant determines image, title and price.
{% enddoc %}
{%- assign pa_item = accessory -%}
{%- liquid
          assign pa_variant = pa_item.selected_or_first_available_variant
          assign pa_image = pa_variant.featured_media.preview_image | default: pa_variant.featured_image | default: pa_item.featured_media.preview_image
          assign pa_title = pa_item.title
          if pa_item.variants.size > 1
            assign pa_title = pa_title | append: ' / ' | append: pa_variant.title
          endif
          assign pa_compare = 0
          if pa_variant.compare_at_price > pa_variant.price
            assign pa_compare = pa_variant.compare_at_price
          endif
        -%}
        <li
          class="pa-card"
          data-pa-item
          data-pa-handle="{{ pa_item.handle }}"
          data-pa-variant="{{ pa_variant.id }}"
          data-pa-price="{{ pa_variant.price }}"
          data-pa-compare="{{ pa_compare }}"
          data-pa-title="{{ pa_title | escape }}"
        >
          <label class="pa-card__label">
            <input class="pa-card__check" type="checkbox" data-pa-check>
            {%- comment -%}
              featured_media.preview_image, the same accessor the theme's own search uses. Most of
              these accessories simply have no photo in Shopify — measured on the live catalogue:
              86% of the cases, 94% of the screen protectors and 76% of the chargers have none — so
              the well falls back to the JOY symbol instead of printing nothing, the way a product
              card without a photo does.
            {%- endcomment -%}
            <span class="pa-card__media">
              {%- if pa_image != blank -%}
                {%- render 'image',
                  image: pa_image,
                  widths: '120,240',
                  sizes: '68px',
                  decorative: true,
                  class: 'pa-card__img'
                -%}
              {%- else -%}
                <img
                  class="pa-card__img pa-card__img--fallback"
                  src="{{ 'logo-joy-symbol.png' | asset_url }}"
                  alt=""
                  width="361"
                  height="472"
                  loading="lazy"
                >
              {%- endif -%}
            </span>
            <span class="pa-card__text">
              {%- comment -%}
                The trailing LRM keeps a title that ends in Latin ("ל-Galaxy S25+", '12.9"') from
                throwing its last mark to the start of the line; <bdi> would reverse every Latin-first title.
              {%- endcomment -%}
              <span class="pa-card__title">{{ pa_title | escape }}&lrm;</span>
              <span class="pa-card__prices">
                <span class="pa-card__price">{{ pa_variant.price | money_without_trailing_zeros }}</span>
                {%- if pa_compare > 0 -%}
                  <s class="pa-card__was">{{ pa_compare | money_without_trailing_zeros }}</s>
                {%- endif -%}
              </span>
            </span>
            {%- comment -%}
              Both icons are always in the DOM and the CSS shows one: a "+" to add, a tick once it is
              chosen. It is a drawing, not a control — the label around the real checkbox is what
              takes the click, so there is no button inside a label.
            {%- endcomment -%}
            <span class="pa-card__mark" aria-hidden="true">
              <span class="pa-card__icon pa-card__icon--plus">{%- render 'icon', name: 'plus', size: 16 -%}</span>
              <span class="pa-card__icon pa-card__icon--check">{%- render 'icon', name: 'check', size: 16 -%}</span>
            </span>
            {%- comment -%}
              The carousel layout's wide button at the foot of the card ("הוספה לערכה" / "בערכה"). Also a
              drawing: the grid layout hides it, and in both the label is what takes the click.
            {%- endcomment -%}
            <span class="pa-card__cta" aria-hidden="true">
              <span class="pa-card__cta-add">{%- render 'icon', name: 'plus', size: 16 -%}{{ 'products.addons.card_add' | t }}</span>
              <span class="pa-card__cta-on">{%- render 'icon', name: 'check', size: 16 -%}{{ 'products.addons.card_on' | t }}</span>
            </span>
          </label>
        </li>
