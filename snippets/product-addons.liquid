{% doc %}
  "השלימו את הערכה" — the accessories that fit the device on the page, rendered as the product
  section's "addons" block, right under the buy buttons.

  There is no separate add button. Ticking a tile adds it to the product's own purchase: the green
  "שריון באילת", the black "הוסף לעגלה" and the phone sticky bar all send the device and every ticked
  accessory in one /cart/add call (assets/product.js asks this element for selectedItems()). The
  buttons show a "+N" badge while something is ticked. Only when the device itself is sold out does
  the module show its own button, so a case can still be bought for a phone the shopper already has.

  The shell only: a pill per group and an empty panel carrying that group's search query. The tiles
  come from sections/product-addons rendered against /search, fetched by assets/product-addons.js
  when the block first comes near the viewport. A product page nobody scrolls costs nothing.

  The model comes off the product title (snippets/accessory-model), so
  "Apple iPhone 17 Pro Max 2TB כחול – יבואן רשמי" asks for "iPhone 17 Pro Max".

  @param {product} product - The product on the page.
  @param {variant} [variant] - The selected variant. Default: selected or first available.
  @param {string} section_id - The calling section's id; keeps the tab/panel ids unique.

  @example
  {% render 'product-addons', product: product, variant: current_variant, section_id: section.id %}
{% enddoc %}
{%- comment -%}
  The groups come from snippets/addon-groups (the theme setting "כללים לאביזרים משלימים", or the
  built-in rules): "###<label>|<word>|<query>" each, in order. The cart's upsell reads the same rules.
{%- endcomment -%}
{%- capture pa_groups -%}{%- render 'addon-groups', product: product -%}{%- endcapture -%}
{%- liquid
  assign pa_group_list = pa_groups | strip | remove_first: '###' | split: '###'
  assign pa_uid = section_id | default: 'pa'
  assign pa_variant = variant | default: product.selected_or_first_available_variant | default: product.variants.first
-%}

{%- if pa_group_list.size > 0 -%}
  {{ 'section-product-addons.css' | asset_url | stylesheet_tag }}
  <script type="module" src="{{ 'product-addons.js' | asset_url }}"></script>

  {%- comment -%}
    data-pa-money is the shop's own money format string. The theme's rule is that money is never
    formatted in JS, and the reason for it is that a hand-rolled format drifts from the shop's. The
    running total has to add numbers, so it cannot be server-rendered — taking the format from
    shop.money_format keeps the guarantee the rule exists for, and the authoritative total is still
    the cart drawer's.
  {%- endcomment -%}
  <product-addons
    class="pa"
    data-pa-main-variant="{{ pa_variant.id }}"
    data-pa-handle="{{ product.handle }}"
    data-pa-base="{{ pa_variant.price }}"
    data-pa-available="{{ pa_variant.available }}"
    data-pa-money="{{ shop.money_format | escape }}"
  >
    <div class="pa__head">
      <h2 class="pa__heading">{{ 'products.addons.heading' | t }}</h2>
      <p class="pa__sub">{{ 'products.addons.sub' | t }}</p>
    </div>

    <div class="pa__tabs" role="tablist" aria-label="{{ 'products.addons.heading' | t }}">
      {%- for pa_group in pa_group_list -%}
        {%- liquid
          assign pa_parts = pa_group | split: '|'
          assign pa_key = 'g' | append: forloop.index
          assign pa_label = pa_parts[0]
        -%}
        <button
          class="pa__tab"
          type="button"
          role="tab"
          id="PaTab-{{ pa_uid }}-{{ pa_key }}"
          aria-controls="PaPanel-{{ pa_uid }}-{{ pa_key }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
        >
          <span class="pa__tab-label">{{ pa_label | escape }}</span>
          <span class="pa__tab-count" data-pa-tab-count hidden></span>
        </button>
      {%- endfor -%}
    </div>

    {%- for pa_group in pa_group_list -%}
      {%- liquid
        assign pa_parts = pa_group | split: '|'
        assign pa_key = 'g' | append: forloop.index
        # Everything after "label|word|" is the query, even if a title ever carries a "|" itself.
        assign pa_prefix = pa_parts[0] | append: '|' | append: pa_parts[1] | append: '|'
        assign pa_query = pa_group | remove_first: pa_prefix | strip
      -%}
      <div
        class="pa__panel"
        role="tabpanel"
        id="PaPanel-{{ pa_uid }}-{{ pa_key }}"
        aria-labelledby="PaTab-{{ pa_uid }}-{{ pa_key }}"
        data-pa-panel
        data-pa-query="{{ pa_query | escape }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        <ul class="pa__list" role="list" data-pa-list>
          {%- for pa_skeleton in (1..4) -%}
            <li class="pa-card pa-card--loading" aria-hidden="true"></li>
          {%- endfor -%}
        </ul>
        <p class="pa__empty" data-pa-empty hidden>{{ 'products.addons.empty' | t }}</p>
      </div>
    {%- endfor -%}

    {%- comment -%}
      The bar sums the device and what is ticked, and says what the product's buttons will do. Its
      own button exists for one case only: the device is sold out, so there is no product button to
      ride on (CSS shows it then, from [data-pa-standalone]).
    {%- endcomment -%}
    <div
      class="pa__bar"
      data-pa-bar
      data-pa-str-hint-idle="{{ 'products.addons.hint_idle' | t | escape }}"
      data-pa-str-hint-one="{{ 'products.addons.hint_one' | t | escape }}"
      data-pa-str-hint-many="{{ 'products.addons.hint_many' | t | escape }}"
      data-pa-str-idle="{{ 'products.addons.cta_idle' | t | escape }}"
      data-pa-str-one="{{ 'products.addons.cta_one' | t | escape }}"
      data-pa-str-many="{{ 'products.addons.cta_active' | t | escape }}"
      data-pa-str-busy="{{ 'products.addons.cta_busy' | t | escape }}"
      data-pa-str-error="{{ 'products.addons.error' | t | escape }}"
      data-pa-str-added="{{ 'products.addons.added' | t | escape }}"
    >
      <p class="pa__hint" data-pa-hint>{{ 'products.addons.hint_idle' | t }}</p>
      <p class="pa__sum">
        <span class="pa__sum-label">{{ 'products.addons.total' | t }}</span>
        <span class="pa__sum-value" data-pa-total>
          {{- pa_variant.price | money_without_trailing_zeros -}}
        </span>
      </p>
      <button class="button button--accent pa__submit" type="button" data-pa-submit disabled>
        <span data-pa-submit-label>{{ 'products.addons.cta_idle' | t }}</span>
      </button>
    </div>
    <p class="pa__error" role="alert" data-pa-error hidden></p>
    <p class="visually-hidden" role="status" aria-live="polite" data-pa-live></p>
  </product-addons>
{%- endif -%}
