<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ 'general.direction' | t }}" class="no-js{% if settings.type_mobile_boost %} text-boost{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% render 'meta-tags' %}

    {%- # Icons and font preloads: same rules as layout/theme.liquid. %}
    {%- if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else %}
      <link rel="icon" type="image/png" sizes="96x96" href="{{ 'favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {%- endif %}

    {%- liquid
      assign font_file = 'assistant'
      if settings.font_family == 'rubik'
        assign font_file = 'rubik'
      endif
      assign font_hebrew = font_file | append: '-hebrew-wght.woff2'
      assign font_latin = font_file | append: '-latin-wght.woff2'
    -%}
    {% # theme-check-disable AssetPreload %}
    <link rel="preload" href="{{ font_hebrew | asset_url | split: '?' | first }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ font_latin | asset_url | split: '?' | first }}" as="font" type="font/woff2" crossorigin>
    {% # theme-check-enable AssetPreload %}
    {{ 'fonts.css' | asset_url | stylesheet_tag }}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    <main id="MainContent" class="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
