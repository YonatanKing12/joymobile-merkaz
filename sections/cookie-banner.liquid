{%- comment -%}
  Shopify-backed consent with explicit acceptance or essential-only choice. A choice is saved only
  after the API confirms all optional categories. Close/Escape choose essential-only. The footer
  opens the choices again. Native Shopify opt-in region settings govern tracking before a choice;
  displaying a banner alone does not configure those settings.
{%- endcomment -%}
{%- render 'section-style', section: section -%}
{%- if section.settings.enabled -%}
  {%- liquid
    assign accept_label = section.settings.accept_label
    if accept_label == blank
      assign accept_label = 'cookie_banner.accept' | t
    endif
    assign decline_label = section.settings.decline_label | default: 'רק עוגיות חיוניות'
  -%}
  <cookie-banner
    class="cookie-banner"
    data-section-id="{{ section.id }}"
    data-stylesheet="{{ 'component-cookie-banner.css' | asset_url }}"
    data-audience="{{ section.settings.audience }}"
    data-renew-days="{{ section.settings.renew_days }}"
    data-saved="{{ 'cookie_banner.saved' | t }}"
    hidden
  >
    <div class="cookie-banner__panel" role="region" aria-label="{{ 'cookie_banner.label' | t }}">
      <div class="cookie-banner__inner page-width">
        <div class="cookie-banner__text">{{ section.settings.text }}</div>
        <p class="cookie-banner__error" data-consent-error role="alert" hidden>לא הצלחנו לשמור את הבחירה ב־Shopify. נסו שוב. הבחירה עדיין לא נשמרה.</p>
        <div class="cookie-banner__actions">
          <button type="button" class="button cookie-banner__button" data-consent="accept">
            {{- accept_label | escape -}}
          </button>
          <button type="button" class="button button--outline cookie-banner__button" data-consent="decline">
            {{- decline_label | escape -}}
          </button>
        </div>
        <button type="button" class="cookie-banner__close" data-consent="decline" aria-label="סגירה ושמירת עוגיות חיוניות בלבד">
          {%- render 'icon', name: 'close', size: 20 -%}
        </button>
      </div>
    </div>
  </cookie-banner>
  <script type="module" src="{{ 'cookie-banner.js' | asset_url }}"></script>
{%- endif -%}

{% schema %}
{
  "name": "באנר עוגיות",
  "tag": "div",
  "class": "section-cookie-banner",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "הצגת באנר העוגיות",
      "default": true
