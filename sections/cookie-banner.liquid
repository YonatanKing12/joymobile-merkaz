    },
    {
      "type": "text",
      "id": "accept_label",
      "label": "כפתור אישור",
      "default": "לאפשר עוגיות נוספות"
    },
    {
      "type": "text",
      "id": "decline_label",
      "label": "כפתור עוגיות חיוניות בלבד",
      "info": "מסרב לעוגיות סטטיסטיקה, שיווק והתאמה אישית. הכפתור תמיד מוצג, גם אם השדה ריק.",
      "default": "רק עוגיות חיוניות"
    },
    {
      "type": "select",
      "id": "audience",
      "label": "למי להציג",
      "options": [
        {
          "value": "all",
          "label": "לכל המבקרים (כמו באתר הקודם)"
        },
        {
          "value": "required",
