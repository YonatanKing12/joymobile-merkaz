{%- comment -%}
  Product carousel: a heading row (bold title at the start, a "view all" link at the end), a collection and up
  to N product cards (snippets/card-product.liquid). Sold-out products are skipped by default (store rule:
  homepage strips show available products only) and the strip is not rendered at all when fewer than 2
  products are left. Products with a photo come first. Per view: 2.2 (<768, the next card peeks in) · 3.2 (768) ·
  4 (992) · 5 (1200) · 6 (1600) · 7 (1920) · 8 (2300).
  The arrows wrap around at the ends. Cards near the top of the page (section index <= 3, first five) are not
  lazy-loaded. The page's HTML holds the first five cards (a full strip from phones to 1599px; eight for a strip
  that can be in the first viewport, a full strip at any width); the rest come
  from assets/product-carousel.js through Section Rendering when the strip nears the viewport.
{%- endcomment -%}
{%- liquid
  assign pc_collection = section.settings.collection
  assign pc_limit = section.settings.products_limit
  assign pc_title = section.settings.title | default: pc_collection.title
  assign pc_view_all_label = section.settings.view_all_label
  if pc_view_all_label == blank
    assign pc_view_all_label = 'home.products.view_all' | t
  endif
  assign pc_carousel_label = pc_title | default: pc_view_all_label

  assign pc_eager = 0
  if section.index != blank and section.index <= 3
    assign pc_eager = 5
  endif

  # Cards printed in the page: five, a full view up to 1599px (2.2 · 3.2 · 4 · 5 per view). A strip that can
  # sit in the first viewport (index 4 or less on the home page) prints eight, a full view at the widest
  # setting too (6 · 7 · 8 per view from 1600px), so it shows no empty slots while the rest are fetched.
  # All of them when the section itself is requested (Section Rendering and the theme editor, where
  # section.index is nil) and when there is no "view all" link, the only way to the rest without JavaScript.
  assign pc_initial = pc_limit
  if section.index != blank and section.settings.show_view_all and pc_collection != blank
    assign pc_initial = 5
    if section.index <= 4
      assign pc_initial = 8
    endif
  endif

  assign pc_count = 0
-%}

{%- comment -%}
  Five passes, each in its source's order: the pinned products (as picked), then the "show first" collection,
  then the main collection, the last two with products that have a photo first and the rest only to fill the
  strip (most of the catalogue has no photo yet). A product already in the strip is not repeated
  (pc_seen holds ",id," for each). Every card of the strip is counted (the arrows depend on the total), only
  the first pc_initial are printed.
{%- endcomment -%}
{%- liquid
  assign pc_pinned = section.settings.pinned_products
  assign pc_first = section.settings.first_collection
  assign pc_seen = ','
-%}
{%- capture pc_slides -%}
  {%- for pc_pass in (1..5) -%}
    {%- liquid
      assign pc_source = nil
      case pc_pass
        when 1
          assign pc_source = pc_pinned
        when 2, 3
          assign pc_source = pc_first.products
        else
          assign pc_source = pc_collection.products
      endcase
      assign pc_photo_pass = pc_pass | modulo: 2
    -%}
    {%- if pc_source == blank -%}
      {%- continue -%}
    {%- endif -%}
    {%- for card_product in pc_source -%}
      {%- if pc_count >= pc_limit -%}
        {%- break -%}
      {%- endif -%}
      {%- liquid
        assign pc_key = ',' | append: card_product.id | append: ','
        if pc_seen contains pc_key
          continue
        endif
        if section.settings.hide_sold_out and card_product.available == false
          continue
        endif
        if section.settings.photos_only and card_product.featured_media == blank
          continue
        endif
        # Passes 2 and 4 take products with a photo, 3 and 5 the rest; pass 1 keeps the picked order.
        if pc_pass > 1
          if pc_photo_pass == 0 and card_product.featured_media == blank
            continue
          endif
          if pc_photo_pass == 1 and card_product.featured_media != blank
            continue
          endif
        endif
        assign pc_seen = pc_seen | append: card_product.id | append: ','
        assign pc_count = pc_count | plus: 1
        if pc_count > pc_initial
          continue
        endif
        assign pc_lazy = true
        if pc_count <= pc_eager
          assign pc_lazy = false
        endif
      -%}
      <div class="carousel__slide product-carousel__slide" role="listitem" data-product-id="{{ card_product.id }}">
        {%- render 'card-product',
          product: card_product,
          lazy: pc_lazy,
          heading: 'h3',
          section_id: section.id,
          show_swatches: settings.card_show_swatches
        -%}
      </div>
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}

{%- liquid
  assign pc_render = false
  assign pc_placeholder = false
  if pc_count >= 2
    assign pc_render = true
  elsif request.design_mode
    assign pc_render = true
    assign pc_placeholder = true
    assign pc_count = 4
  endif
-%}

{%- if pc_render -%}
  {%- comment -%} Arrows only where the cards overflow: 2 · 3 (768) · 4 (992) · 5 (1200) · 6 (1600) · 7 (1920) · 8 (2300) whole cards per view. {%- endcomment -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --pc-pad-top: {{ section.settings.padding_top }}px;
      --pc-pad-bottom: {{ section.settings.padding_bottom }}px;
      {%- if section.settings.background != blank and section.settings.background.alpha > 0 %}
      --pc-bg: {{ section.settings.background }};
      {%- endif %}
      {%- case section.settings.title_size -%}
        {%- when 'small' %}
      --pc-title-size: var(--text-xl);
        {%- when 'large' %}
      --pc-title-size: var(--text-3xl);
      {%- endcase %}
      --pc-scroll-md: {% if pc_count > 3 %}grid{% else %}none{% endif %};
      --pc-scroll-lg: {% if pc_count > 4 %}grid{% else %}none{% endif %};
      --pc-scroll-xl: {% if pc_count > 5 %}grid{% else %}none{% endif %};
      --pc-scroll-2xl: {% if pc_count > 6 %}grid{% else %}none{% endif %};
      --pc-scroll-3xl: {% if pc_count > 7 %}grid{% else %}none{% endif %};
      --pc-scroll-4xl: {% if pc_count > 8 %}grid{% else %}none{% endif %};
    }
  {%- endstyle -%}

  {{ 'component-carousel.css' | asset_url | stylesheet_tag }}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-badges.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatches.css' | asset_url | stylesheet_tag }}
  {{ 'component-wishlist-button.css' | asset_url | stylesheet_tag }}
  {{ 'section-product-carousel.css' | asset_url | stylesheet_tag }}
  <script type="module" src="{{ 'carousel.js' | asset_url }}"></script>
  <script type="module" src="{{ 'product.js' | asset_url }}"></script>
  {%- if pc_count > pc_initial -%}
    <script type="module" src="{{ 'product-carousel.js' | asset_url }}"></script>
  {%- endif -%}

  <product-carousel
    class="product-carousel{% if section.settings.background != blank and section.settings.background.alpha > 0 %} product-carousel--bg{% endif %}"
    data-section-id="{{ section.id }}"
    {% if pc_count > pc_initial %}
      data-more
    {% endif %}
  >
    <div class="product-carousel__inner">
      {%- if pc_title != blank or section.settings.show_view_all -%}
        <div class="product-carousel__head">
          {%- if pc_title != blank -%}
            <h2 class="product-carousel__title">{{ pc_title | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.show_view_all and pc_collection != blank -%}
            <a class="product-carousel__view-all" href="{{ pc_collection.url }}">
              {{- pc_view_all_label | escape -}}
              {%- render 'icon', name: 'chevron-left', size: 16 -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if pc_placeholder -%}
        <p class="product-carousel__notice">
          {%- if pc_collection == blank -%}
            {{ 'home.products.editor_empty' | t }}
          {%- else -%}
            {{ 'home.products.editor_too_few' | t }}
          {%- endif -%}
        </p>
      {%- endif -%}

      <carousel-slider
        role="group"
        class="product-carousel__carousel"
        data-autoplay="0"
        data-loop="true"
        aria-roledescription="{{ 'accessibility.carousel.label' | t }}"
        aria-label="{{ pc_carousel_label | escape }}"
      >
        {%- comment -%} Focusable only with placeholders (no links inside): then it needs a name of its own. {%- endcomment -%}
        <div
          class="carousel__track product-carousel__track"
          role="list"
          {% if pc_placeholder %}
            tabindex="0"
            aria-label="{{ 'accessibility.carousel.slides' | t: label: pc_carousel_label }}"
          {% else %}
            tabindex="-1"
          {% endif %}
        >
          {%- if pc_placeholder -%}
            {%- for i in (1..4) -%}
              <div class="carousel__slide product-carousel__slide" role="listitem">
                <div class="product-carousel__placeholder">
                  {{- 'product-' | append: i | placeholder_svg_tag: 'product-carousel__placeholder-svg' -}}
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {{- pc_slides -}}
          {%- endif -%}
        </div>
        <button class="carousel__btn carousel__btn--prev product-carousel__arrow" type="button" aria-label="{{ 'accessibility.carousel.previous' | t }}">
          {%- render 'icon', name: 'chevron-right', size: 20 -%}
        </button>
        <button class="carousel__btn carousel__btn--next product-carousel__arrow" type="button" aria-label="{{ 'accessibility.carousel.next' | t }}">
          {%- render 'icon', name: 'chevron-left', size: 20 -%}
        </button>
      </carousel-slider>

    </div>
  </product-carousel>
{%- endif -%}

{% schema %}
{
  "name": "קרוסלת מוצרים",
  "tag": "section",
  "class": "section-product-carousel",
  "disabled_on": {
    "groups": ["header", "aside"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "כותרת",
      "info": "ריק = שם הקטגוריה.",
      "default": "מוצרים פופולאריים"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "קטגוריה"
    },
    {
      "type": "product_list",
      "id": "pinned_products",
      "label": "מוצרים מוצמדים ראשונים",
      "info": "מוצגים בתחילת הקרוסלה לפי הסדר שנבחר, לפני כל השאר.",
      "limit": 12
    },
    {
      "type": "collection",
      "id": "first_collection",
      "label": "קטגוריה שמוצגת ראשונה",
      "info": "המוצרים שלה באים מיד אחרי המוצרים המוצמדים ולפני הקטגוריה הראשית. למשל קטגוריית אייפון 17 ו-18 בקרוסלת הסמארטפונים. מוצר שמופיע בשתיהן מוצג פעם אחת."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "מספר מוצרים",
      "info": "10 = שני עמודים במחשב. חמשת הכרטיסים הראשונים נטענים עם העמוד והשאר כשהגולש מתקרב לקרוסלה, כך שמספר גבוה לא מאט את טעינת העמוד.",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "הסתרת מוצרים שאזלו מהמלאי",
      "info": "כשנשארים פחות משני מוצרים זמינים הקרוסלה לא מוצגת.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "photos_only",
      "label": "רק מוצרים עם תמונה",
      "default": false
    },
    {
      "type": "header",
      "content": "עיצוב"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "גודל הכותרת",
      "options": [
        { "value": "small", "label": "קטן" },
        { "value": "medium", "label": "רגיל" },
        { "value": "large", "label": "גדול" }
      ],
      "default": "medium"
    },
    {
      "type": "color",
      "id": "background",
      "label": "צבע רקע",
      "info": "ריק = רקע העמוד.",
      "alpha": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "קישור \"לכל המוצרים\"",
      "info": "מוצג בקצה שורת הכותרת.",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "טקסט הקישור",
      "default": "לכל המוצרים"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "ריווח עליון",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "ריווח תחתון",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "קרוסלת מוצרים"
    }
  ]
}
{% endschema %}
