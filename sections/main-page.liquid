{%- comment -%}
  Generic page: breadcrumbs, the page title as the single <h1> and the page body as
  long-form rich text (.prose, assets/section-page.css). The Konimbo pages had no
  real h1 (the title lived in the breadcrumbs); here page.title is always the h1.

  Also the first section of the page templates with a suffix (contact, faqs,
  wishlist, branches): there the body is usually empty, so only the title renders
  and the sections below carry the content. "Page width" keeps the title aligned
  with those full-width sections.
{%- endcomment -%}
{%- render 'section-style', section: section -%}
{{ 'section-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_content = false
  if page.content != blank
    assign has_content = true
  endif
-%}

<div class="main-page page-width main-page--{{ section.settings.content_width }}{% unless has_content %} main-page--title-only{% endunless %}">
  <div class="main-page__inner">
    {%- if section.settings.show_breadcrumbs -%}
      {%- render 'breadcrumbs', class: 'main-page__breadcrumbs' -%}
    {%- endif -%}

    {%- if section.settings.show_title -%}
      <h1 class="main-page__title">{{ page.title | escape }}</h1>
    {%- endif -%}

    {%- if has_content -%}
      <div class="main-page__content rte prose">
        {{ page.content }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "תוכן העמוד",
  "class": "section-main-page",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "מסלול ניווט (פירורי לחם)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "כותרת העמוד",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "רוחב",
      "options": [
        {
          "value": "narrow",
          "label": "צר, לקריאה נוחה"
        },
        {
          "value": "wide",
          "label": "כרוחב האתר"
        }
      ],
      "default": "narrow",
      "info": "'כרוחב האתר' מיישר את הכותרת עם הסקשנים שמתחתיה (טופס יצירת קשר, סניפים, שאלות נפוצות)."
    },
    {
      "type": "header",
      "content": "עיצוב הסקשן"
    },
    {
      "type": "paragraph",
      "content": "כל מה שנשאר ריק לוקח את העיצוב הכללי של האתר (הגדרות התבנית › צבעים, טיפוגרפיה)."
    },
    {
      "type": "select",
      "id": "ss_visibility",
      "label": "איפה להציג את הסקשן",
      "options": [
        {
          "value": "all",
          "label": "במחשב ובטלפון"
        },
        {
          "value": "desktop",
          "label": "רק במחשב"
        },
        {
          "value": "mobile",
          "label": "רק בטלפון"
        }
      ],
      "default": "all"
    },
    {
      "type": "color_background",
      "id": "ss_background",
      "label": "רקע",
      "info": "צבע אחיד או מעבר צבעים (גרדיאנט)."
    },
    {
      "type": "color",
      "id": "ss_text_color",
      "label": "צבע טקסט"
    },
    {
      "type": "color",
      "id": "ss_heading_color",
      "label": "צבע כותרות"
    },
    {
      "type": "color",
      "id": "ss_accent_color",
      "label": "צבע הדגשה",
      "info": "קישורים, אייקונים ופרטים צבעוניים."
    },
    {
      "type": "color",
      "id": "ss_button_bg",
      "label": "צבע כפתורים"
    },
    {
      "type": "color",
      "id": "ss_button_text",
      "label": "צבע טקסט בכפתורים"
    },
    {
      "type": "range",
      "id": "ss_text_scale",
      "label": "גודל טקסט",
      "min": 80,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "ss_radius",
      "label": "פינות של כפתורים וכרטיסים",
      "options": [
        {
          "value": "theme",
          "label": "כמו בשאר האתר"
        },
        {
          "value": "square",
          "label": "ישרות"
        },
        {
          "value": "soft",
          "label": "מעוגלות מעט"
        },
        {
          "value": "round",
          "label": "מעוגלות"
        },
        {
          "value": "pill",
          "label": "עגולות לגמרי"
        }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "ss_custom_heading_font",
      "label": "פונט אחר לכותרות",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "ss_heading_font",
      "label": "פונט כותרות",
      "info": "פונטים עם עברית: Assistant, Rubik, Frank Ruhl Libre.",
      "default": "assistant_n7",
      "visible_if": "{{ section.settings.ss_custom_heading_font }}"
    },
    {
      "type": "checkbox",
      "id": "ss_custom_body_font",
      "label": "פונט אחר לטקסט",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "ss_body_font",
      "label": "פונט טקסט",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.ss_custom_body_font }}"
    }
  ],
  "presets": [
    {
      "name": "תוכן העמוד"
    }
  ]
}
{% endschema %}
