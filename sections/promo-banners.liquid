{%- comment -%}
  Promo banners: one to three promotional images side by side (stacked on phones, or a swipe row), each a
  single link. Meant for the home page between product strips. Every banner keeps its image's own ratio;
  with "same height" the row takes the first banner's ratio and the others are cropped to it (object-fit).
  Banners without an image show a placeholder in the theme editor only.
{%- endcomment -%}
{%- render 'section-style', section: section -%}
{%- liquid
  # pb_count: banners in the desktop row (a phone-only banner does not take a column there).
  assign pb_count = 0
  assign pb_any = false
  for block in section.blocks
    if block.settings.image != blank or block.settings.image_mobile != blank or request.design_mode
      assign pb_any = true
      if block.settings.show_on != 'mobile'
        assign pb_count = pb_count | plus: 1
      endif
    endif
  endfor

  assign pb_loading = 'lazy'
  if section.index != blank and section.index <= 2
    assign pb_loading = 'eager'
  endif

  case pb_count
    when 1
      assign pb_sizes = '(min-width: 1360px) 1320px, calc(100vw - 30px)'
    when 2
      assign pb_sizes = '(min-width: 1360px) 652px, (min-width: 768px) calc(50vw - 23px), calc(100vw - 30px)'
    else
      assign pb_sizes = '(min-width: 1360px) 430px, (min-width: 768px) calc(33vw - 20px), calc(100vw - 30px)'
  endcase

  assign pb_first = section.blocks | where: 'type', 'banner' | first
  assign pb_ratio = pb_first.settings.image.aspect_ratio | default: 2

  # "גודל הבאנר": a fixed box (ratio or height) that every banner fills, the image cropped to it
  # (object-fit: cover, from the "מיקום התמונה" point). 'image' keeps the image's own shape.
  assign pb_box = ''
  case section.settings.banner_size
    when 'custom'
      assign pb_box = 'aspect-ratio: auto; height: ' | append: section.settings.banner_height | append: 'px;'
    when 'image'
      assign pb_box = ''
    else
      assign pb_box = 'aspect-ratio: ' | append: section.settings.banner_size | append: ';'
  endcase
  assign pb_box_mobile = ''
  case section.settings.banner_size_mobile
    when 'same'
      assign pb_box_mobile = pb_box
    when 'custom'
      assign pb_box_mobile = 'aspect-ratio: auto; height: ' | append: section.settings.banner_height_mobile | append: 'px;'
    when 'image'
      assign pb_box_mobile = ''
    else
      assign pb_box_mobile = 'aspect-ratio: ' | append: section.settings.banner_size_mobile | append: ';'
  endcase
-%}

{%- if pb_any -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --pb-pad-top: {{ section.settings.padding_top }}px;
      --pb-pad-bottom: {{ section.settings.padding_bottom }}px;
      --pb-gap: {{ section.settings.gap }}px;
      --pb-radius: {{ section.settings.radius }}px;
      --pb-cols: {{ pb_count | at_least: 1 }};
      {%- if section.settings.same_height %}
      --pb-ratio: {{ pb_ratio }};
      {%- endif %}
      --pb-focus: {{ section.settings.image_position | default: 'center' }};
    }
    {%- if pb_box != blank %}
    @media (min-width: 768px) {
      #shopify-section-{{ section.id }} .promo-banners__item { {{ pb_box }} }
    }
    {%- endif %}
    {%- if pb_box_mobile != blank %}
    @media (max-width: 767px) {
      #shopify-section-{{ section.id }} .promo-banners__item { {{ pb_box_mobile }} }
    }
    {%- endif %}
  {%- endstyle -%}

  {{ 'section-promo-banners.css' | asset_url | stylesheet_tag }}

  <div class="promo-banners{% if section.settings.full_width %} promo-banners--full{% else %} page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="promo-banners__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="promo-banners__row promo-banners__row--mobile-{{ section.settings.mobile_layout }}{% if section.settings.same_height %} promo-banners__row--even{% endif %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign pb_image = block.settings.image | default: block.settings.image_mobile
          if pb_image == blank and request.design_mode == false
            continue
          endif
          assign pb_image_mobile = block.settings.image_mobile
          assign pb_alt = block.settings.alt | default: pb_image.alt | strip
          assign pb_tag = 'div'
          if block.settings.link != blank
            assign pb_tag = 'a'
          endif
        -%}
        <{{ pb_tag }}
          class="promo-banners__item promo-banners__item--{{ block.settings.show_on | default: 'all' }}"
          {% if pb_tag == 'a' %}
            href="{{ block.settings.link }}"
            {% if pb_alt == blank and block.settings.label == blank %}
              aria-label="{{ 'home.banner.link_label' | t }}"
            {% endif %}
          {% endif %}
          {{ block.shopify_attributes }}
          {% if pb_image != blank %}
            style="--pb-item-ratio: {{ pb_image.aspect_ratio }};{% if pb_image_mobile != blank %} --pb-item-ratio-mobile: {{ pb_image_mobile.aspect_ratio }};{% endif %}"
          {% endif %}
        >
          {%- if pb_image == blank -%}
            {{- 'image' | placeholder_svg_tag: 'promo-banners__placeholder' -}}
          {%- elsif pb_image_mobile != blank -%}
            <picture>
              <source
                media="(min-width: 768px)"
                srcset="{%- for w in (1..4) -%}{%- assign pw = w | times: 400 -%}{%- if pw < pb_image.width -%}{{ pb_image | image_url: width: pw }} {{ pw }}w, {% endif -%}{%- endfor -%}{{ pb_image | image_url: width: pb_image.width }} {{ pb_image.width }}w"
                sizes="{{ pb_sizes }}"
                width="{{ pb_image.width }}"
                height="{{ pb_image.height }}"
              >
              {%- render 'image',
                image: pb_image_mobile,
                widths: '390,540,750,1080',
                sizes: 'calc(100vw - 30px)',
                loading: pb_loading,
                class: 'promo-banners__img',
                alt: pb_alt
              -%}
            </picture>
          {%- else -%}
            {%- render 'image',
              image: pb_image,
              widths: '390,540,750,1080,1500',
              sizes: pb_sizes,
              loading: pb_loading,
              class: 'promo-banners__img',
              alt: pb_alt
            -%}
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <span class="promo-banners__label">{{ block.settings.label | escape }}</span>
          {%- endif -%}
        </{{ pb_tag }}>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
