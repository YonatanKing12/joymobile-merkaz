      "id": "banner_size",
      "label": "גודל הבאנר במחשב",
      "info": "כל באנר ממלא את המסגרת והתמונה נחתכת אליה. \"לפי התמונה\" = בלי חיתוך.",
      "options": [
        {
          "value": "image",
          "label": "לפי התמונה"
        },
        {
          "value": "5 / 1",
          "label": "נמוך מאוד (5:1)"
        },
        {
          "value": "4 / 1",
          "label": "נמוך (4:1)"
        },
        {
          "value": "3 / 1",
          "label": "בינוני (3:1)"
        },
        {
          "value": "2 / 1",
          "label": "גבוה (2:1)"
        },
        {
          "value": "3 / 2",
          "label": "כרטיס (3:2)"
        },
        {
          "value": "1 / 1",
          "label": "ריבוע (1:1)"
        },
        {
          "value": "custom",
          "label": "גובה קבוע בפיקסלים"
        }
