{%- comment -%}
  Branches + pickup facts (anchor id "branches", so any link can point to
  <page>#branches). Konimbo's branches page stacked 5 branches, each with a name,
  services line, address, hours and an eagerly loaded Google Maps iframe; here every
  branch is a card (snippets/branch-card.liquid).

  Where the branches come from: the "branch" metaobject (Admin › תוכן › מטא-אובייקטים ›
  סניף), the one place the merchant edits a branch — the home page's structured data
  (snippets/branches-json.liquid) and the repair form's branch list read the same entries.
  Entries are ordered by their "סדר הצגה" field (snippets/branch-order.liquid). Only when the
  store has no active entry does the section fall back to its own `branch` blocks
  (templates/page.branches.json and page.contact.json hold the five locations), so the page
  never goes empty. The pickup facts are always blocks.

  Maps: the address builds a Google Maps link and a Waze link; the embedded map loads only
  when the visitor opens it (<branch-map> below copies the frame's data-src on the
  <details> toggle), so no third-party request happens until the visitor asks for it.

  Structured data (section setting "נתונים מובנים", on in templates/page.branches.json
  only): every branch with a name and an address becomes a store in one JSON-LD @graph
  (snippets/branch-json.liquid: address, phone, hours, coordinates, link to its card, parent
  Organization). The machine-readable hours come from "שעות פתיחה למנועי חיפוש"
  (Su-Th 10:00-23:00; Fr 10:00-14:00), never from the free text, and hours that move with
  Shabbat stay out of it. Only one page should carry the stores (the contact page shows the
  same branches without them).
{%- endcomment -%}
{%- render 'section-style', section: section -%}
{{ 'section-branches.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fact_count = 0
  for block in section.blocks
    if block.type == 'fact'
      assign fact_count = fact_count | plus: 1
    endif
  endfor

  capture branch_order
    render 'branch-order'
  endcapture
  assign branch_order = branch_order | split: ','
-%}

<div class="branches page-width" id="branches">
  {%- if section.settings.banner != blank -%}
    <div class="branches__banner">
      {%- render 'image',
        image: section.settings.banner,
        widths: '750,1100,1500,2200',
        sizes: '(min-width: 1200px) 1170px, calc(100vw - 30px)',
        class: 'branches__banner-image'
      -%}
    </div>
  {%- endif -%}

  {%- if section.settings.heading != blank or section.settings.intro != blank -%}
    <div class="branches__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="branches__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="branches__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="branches__list">
    {%- if branch_order.size > 0 -%}
      {%- for branch_position in branch_order -%}
        {%- assign branch_index = branch_position | plus: 0 -%}
        {%- for entry in metaobjects.branch.values -%}
          {%- if forloop.index0 == branch_index -%}
            {%- liquid
              assign entry_text = ''
              if entry.text != blank
                assign entry_text = entry.text | metafield_tag
              endif
            -%}
            {%- render 'branch-card',
              id: entry.system.handle,
              name: entry.name.value,
              services: entry.services.value,
              address: entry.address.value,
              hours: entry.hours.value,
              phone: entry.phone.value,
              text: entry_text,
              map_query: entry.map_query.value,
              image: entry.image.value.preview_image,
              show_map: section.settings.show_map
            -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'branch' -%}
          {%- render 'branch-card',
            id: block.id,
            name: block.settings.name,
            services: block.settings.services,
            address: block.settings.address,
            hours: block.settings.hours,
            phone: block.settings.phone,
            text: block.settings.text,
            map_query: block.settings.map_query,
            image: block.settings.image,
            show_map: section.settings.show_map,
            attributes: block.shopify_attributes
          -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if fact_count > 0 -%}
    <div class="branches__facts">
      {%- if section.settings.facts_heading != blank -%}
        <h3 class="branches__facts-heading">{{ section.settings.facts_heading | escape }}</h3>
      {%- endif -%}
      <ul class="pickup-facts" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'fact' -%}
            <li class="pickup-fact" {{ block.shopify_attributes }}>
              {%- render 'icon', name: block.settings.icon, size: 28, class: 'pickup-fact__icon' -%}
              <div class="pickup-fact__body">
                {%- if block.settings.title != blank -%}
                  <p class="pickup-fact__title">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="pickup-fact__text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{%- if section.settings.show_map -%}
  {%- # Inline: defined once per page; a section re-rendered by the theme editor upgrades on its own. -%}
  <script type="module">
    import { define } from '@theme/global';

    // The map frame gets its src only when the visitor opens the <details>: no Google request (or
    // cookie) before that tap. The fallback link is for visitors without JavaScript.
    define('branch-map', class extends HTMLElement {
      connectedCallback() {
        this.details = this.querySelector('details');
        this.details?.addEventListener('toggle', this);
        if (this.details?.open) this.handleEvent();
      }

      disconnectedCallback() {
        this.details?.removeEventListener('toggle', this);
      }

      handleEvent() {
        const frame = this.querySelector('iframe[data-src]');
        if (!this.details.open || !frame) return;
        frame.src = frame.dataset.src;
        frame.removeAttribute('data-src');
        frame.hidden = false;
        this.querySelector('[data-map-fallback]')?.setAttribute('hidden', '');
      }
    });
  </script>
{%- endif -%}

{%- if section.settings.structured_data -%}
  {%- liquid
    assign ld_page_url = request.origin | append: request.path
    assign ld_store_count = 0
  -%}
  {%- capture ld_stores -%}
    {%- if branch_order.size > 0 -%}
      {%- for branch_position in branch_order -%}
        {%- assign branch_index = branch_position | plus: 0 -%}
        {%- for entry in metaobjects.branch.values -%}
          {%- if forloop.index0 == branch_index and entry.name.value != blank and entry.address.value != blank -%}
            {%- if ld_store_count > 0 -%},{%- endif -%}
            {%- assign ld_store_count = ld_store_count | plus: 1 -%}
            {%- render 'branch-json',
              id: entry.system.handle,
              name: entry.name.value,
              address: entry.address.value,
              services: entry.services.value,
              phone: entry.phone.value,
              hours_spec: entry.hours_spec.value,
              geo: entry.geo.value,
              map_query: entry.map_query.value,
              image: entry.image.value.preview_image,
              page_url: ld_page_url
            -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'branch' and block.settings.name != blank and block.settings.address != blank -%}
          {%- if ld_store_count > 0 -%},{%- endif -%}
          {%- assign ld_store_count = ld_store_count | plus: 1 -%}
          {%- render 'branch-json',
            id: block.id,
            name: block.settings.name,
            address: block.settings.address,
            services: block.settings.services,
            phone: block.settings.phone,
            hours_spec: block.settings.hours_spec,
            geo: block.settings.geo,
            map_query: block.settings.map_query,
            image: block.settings.image,
            page_url: ld_page_url
          -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}
  {%- if ld_store_count > 0 -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@graph":[{{ ld_stores | strip_newlines | replace: '</', '<\/' }}]}</script>
  {%- endif -%}
{%- endif -%}

