{%- comment -%}
  Site footer (konimbo-home-chrome.md §3.8), full-bleed on the footer colour (no white side
  edges): up to four columns from 768px — store menus (footer-1/2/3) instead of the old
  53-link category dump, and the Eilat branch block (address, opening hours, map link built
  from the address, phone, WhatsApp, social links). Column headings are 16px/52px bold with
  the 41×2 mint rule. Below 768px each menu column is an accordion row (<details>); the
  branch block stays open. Bottom bar: payment marks from shop.enabled_payment_types, the
  `footer` menu, the accessibility statement, policies and ©.
  Menu columns are rendered twice (accordion for phones, plain column from 768px) because a
  closed <details> can't be forced open by CSS in every supported browser; only one copy is
  ever displayed, so screen readers meet each link once. Both copies carry the column's <h2>
  (on phones inside the <summary>), so the heading outline is the same at every width.
{%- endcomment -%}
{%- render 'section-style', section: section -%}
{%- liquid
  # The flagship's address, hours and map search come from its "branch" metaobject entry
  # (handle branch-flagship), the same entry the branches page shows, so a change there reaches the
  # footer too. The theme settings (store_street, store_city, store_hours) are the fallback when
  # the store has no such entry.
  assign flagship = metaobjects.branch['branch-flagship']
  assign store_address = flagship.address.value | strip
  assign store_hours = flagship.hours.value | strip
  assign map_query = flagship.map_query.value | strip
  if store_address == blank
    assign store_address = settings.store_street | strip
    if settings.store_city != blank
      if store_address != blank
        assign store_address = store_address | append: ', '
      endif
      assign store_address = store_address | append: settings.store_city
    endif
  endif
  if store_hours == blank
    assign store_hours = settings.store_hours | strip
  endif
  if map_query == blank
    assign map_query = store_address
  endif
  assign map_query = map_query | url_encode
  assign map_url = 'https://www.google.com/maps/search/?api=1&query=' | append: map_query

  # tel: link from the same rules as the WhatsApp link (snippets/phone-href).
  capture phone_href
    render 'phone-href', phone: settings.contact_phone
  endcapture

  capture wa_url
    render 'whatsapp-url'
  endcapture
  capture wa_display
    render 'whatsapp-url', format: 'display'
  endcapture

  assign statement_url = ''
  if settings.a11y_statement_page != blank
    assign statement_url = settings.a11y_statement_page.url
  elsif pages.accessibility.url != blank
    assign statement_url = pages.accessibility.url
  endif

  assign branches_url = ''
  if settings.branches_page != blank
    assign branches_url = settings.branches_page.url
  endif

  assign column_count = 0
  for block in section.blocks
    if block.type != '@app'
      assign column_count = column_count | plus: 1
    endif
  endfor
  if column_count > 4
    assign column_count = 4
  endif
  if column_count < 1
    assign column_count = 1
  endif
  assign current_year = 'now' | date: '%Y'
  assign brand_name = settings.brand_name | strip | default: shop.name
-%}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="footer" style="--footer-columns: {{ column_count }}">
  <div class="footer__inner page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__columns">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="footer__app">{% render block %}</div>

            {%- when 'menu' -%}
              {%- assign block_menu = block.settings.menu -%}
              {%- assign block_heading = block.settings.heading | default: block_menu.title -%}
              <div class="footer__block footer__block--menu" {{ block.shopify_attributes }}>
                <details class="footer__accordion">
                  <summary class="footer__accordion-toggle">
                    <h2 class="footer__heading-text">{{ block_heading | escape }}</h2>
                    {%- render 'icon', name: 'chevron-down', size: 18, class: 'footer__accordion-icon' -%}
                  </summary>
                  <ul class="footer__links" role="list">
                    {%- for link in block_menu.links -%}
                      <li>
                        <a
                          class="footer__link"
                          href="{{ link.url }}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- link.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
                <div class="footer__column">
                  <h2 class="footer__heading">{{ block_heading | escape }}</h2>
                  <ul class="footer__links" role="list">
                    {%- for link in block_menu.links -%}
                      <li>
                        <a
                          class="footer__link"
                          href="{{ link.url }}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- link.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>

            {%- when 'branches' -%}
              {%- liquid
                assign branch_heading = block.settings.heading
                if branch_heading == blank
                  assign branch_heading = 'footer.branches.heading' | t
                endif
              -%}
              <div class="footer__block footer__block--branches" {{ block.shopify_attributes }}>
                <h2 class="footer__heading">{{ branch_heading | escape }}</h2>
                <div class="footer__branch">
                  {%- if block.settings.name != blank -%}
                    <p class="footer__branch-name">{{ block.settings.name | escape }}</p>
                  {%- endif -%}
                  <dl class="footer__facts">
                    {%- if store_address != blank -%}
                      <div class="footer__fact">
                        <dt>{%- render 'icon', name: 'location', size: 18 -%}<span class="visually-hidden">{{ 'footer.branches.address' | t }}</span></dt>
                        <dd>
                          <span>{{ store_address | escape }}</span>
                          <a class="footer__link footer__map-link" href="{{ map_url }}" target="_blank" rel="noopener">
                            {{- 'footer.branches.map' | t -}}
                            <span class="visually-hidden"> {{ 'general.new_window' | t }}</span>
                          </a>
                        </dd>
                      </div>
                    {%- endif -%}
                    {%- if store_hours != blank -%}
                      <div class="footer__fact">
                        <dt>{%- render 'icon', name: 'clock', size: 18 -%}<span class="visually-hidden">{{ 'footer.branches.hours' | t }}</span></dt>
                        <dd>{{ store_hours | escape | newline_to_br }}</dd>
                      </div>
                    {%- endif -%}
                    {%- if phone_href != blank -%}
                      <div class="footer__fact">
                        <dt>{%- render 'icon', name: 'phone', size: 18 -%}<span class="visually-hidden">{{ 'footer.branches.phone' | t }}</span></dt>
                        <dd><a class="footer__link" href="{{ phone_href }}" dir="ltr">{{ settings.contact_phone | strip | escape }}</a></dd>
                      </div>
                    {%- endif -%}
                    {%- if wa_url != blank -%}
                      <div class="footer__fact">
                        <dt>{%- render 'icon', name: 'whatsapp', size: 18 -%}<span class="visually-hidden">{{ 'footer.branches.whatsapp' | t }}</span></dt>
                        <dd>
                          <a class="footer__link" href="{{ wa_url }}" target="_blank" rel="noopener">
                            <span dir="ltr">{{ wa_display | escape }}</span>
                            <span class="visually-hidden"> {{ 'general.new_window' | t }}</span>
                          </a>
                        </dd>
                      </div>
                    {%- endif -%}
                    {%- if settings.contact_email != blank -%}
                      <div class="footer__fact">
                        <dt>{%- render 'icon', name: 'mail', size: 18 -%}<span class="visually-hidden">{{ 'footer.branches.email' | t }}</span></dt>
                        <dd><a class="footer__link" href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a></dd>
                      </div>
                    {%- endif -%}
                  </dl>
                  {%- if block.settings.text != blank -%}
                    <div class="footer__text rte">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {%- if branches_url != blank -%}
                    <a class="footer__link footer__more" href="{{ branches_url }}">{{ 'footer.branches.all' | t }}</a>
                  {%- endif -%}
                </div>
                {%- if block.settings.show_social -%}
                  <div class="footer__social">
                    <p class="footer__subheading">{{ 'footer.social_heading' | t }}</p>
                    {%- render 'social-links', class: 'footer__social-list', size: 22, whatsapp: false -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'social' -%}
              {%- liquid
                assign social_heading = block.settings.heading
                if social_heading == blank
                  assign social_heading = 'footer.social_heading' | t
                endif
              -%}
              <div class="footer__block footer__block--social" {{ block.shopify_attributes }}>
                <h2 class="footer__heading">{{ social_heading | escape }}</h2>
                {%- render 'social-links', class: 'footer__social-list', size: 22, whatsapp: block.settings.show_whatsapp -%}
              </div>

            {%- when 'text' -%}
              <div class="footer__block footer__block--text" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <div class="footer__text rte">{{ block.settings.text }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      {%- if section.settings.show_payment_icons -%}
        {%- render 'payment-icons', class: 'footer__payments' -%}
      {%- endif -%}

      <nav class="footer__legal" aria-label="{{ 'footer.legal_label' | t }}">
        <ul class="footer__legal-list" role="list">
          {%- for link in section.settings.bottom_menu.links -%}
            <li>
              <a
                class="footer__link"
                href="{{ link.url }}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
          {%- if statement_url != blank -%}
            <li><a class="footer__link" href="{{ statement_url }}">{{ 'footer.accessibility' | t }}</a></li>
          {%- endif -%}
          {%- if section.settings.show_policies -%}
            {%- # The Hebrew pages (handles privacy, terms, returns) win over Shopify's policy pages when they exist. -%}
            {%- liquid
              assign privacy_url = pages['privacy'].url | default: shop.privacy_policy.url
              assign terms_url = pages['terms'].url | default: shop.terms_of_service.url
              assign refund_url = pages['returns'].url | default: shop.refund_policy.url
            -%}
            {%- if privacy_url != blank -%}
              <li><a class="footer__link" href="{{ privacy_url }}">{{ 'footer.privacy' | t }}</a></li>
            {%- endif -%}
            {%- if terms_url != blank -%}
              <li><a class="footer__link" href="{{ terms_url }}">{{ 'footer.terms' | t }}</a></li>
            {%- endif -%}
            {%- if refund_url != blank -%}
              <li><a class="footer__link" href="{{ refund_url }}">{{ 'footer.refund' | t }}</a></li>
            {%- endif -%}
          {%- endif -%}
        </ul>
      </nav>

      <p class="footer__copyright">
        {%- if section.settings.copyright != blank -%}
          {{ section.settings.copyright }}
        {%- else -%}
          {{ 'footer.copyright' | t: year: current_year, shop: brand_name }}
        {%- endif -%}
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "כותרת תחתונה",
  "tag": "div",
  "class": "section-footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "עד ארבע עמודות מ-768 פיקסלים. במובייל כל תפריט הוא שורה נפתחת."
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "תפריט בשורה התחתונה",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "סמלי אמצעי תשלום",
      "info": "האמצעים שפעילים בקופה של Shopify — מתעדכן לבד.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "קישורי מדיניות",
      "info": "פרטיות, תקנון והחזרות — רק מדיניות שקיימת בחנות.",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "copyright",
      "label": "טקסט זכויות יוצרים",
      "info": "אם ריק: © [שנה] [שם המותג מהגדרות התבנית]. כל הזכויות שמורות."
    },
    {
      "type": "header",
      "content": "עיצוב הסקשן"
    },
    {
      "type": "paragraph",
      "content": "כל מה שנשאר ריק לוקח את העיצוב הכללי של האתר (הגדרות התבנית › צבעים, טיפוגרפיה)."
    },
    {
      "type": "color_background",
      "id": "ss_background",
      "label": "רקע",
      "info": "צבע אחיד או מעבר צבעים (גרדיאנט)."
    },
    {
      "type": "color",
      "id": "ss_text_color",
      "label": "צבע טקסט"
    },
    {
      "type": "color",
      "id": "ss_heading_color",
      "label": "צבע כותרות"
    },
    {
      "type": "color",
      "id": "ss_accent_color",
      "label": "צבע הדגשה",
      "info": "קישורים, אייקונים ופרטים צבעוניים."
    },
    {
      "type": "color",
      "id": "ss_button_bg",
      "label": "צבע כפתורים"
    },
    {
      "type": "color",
      "id": "ss_button_text",
      "label": "צבע טקסט בכפתורים"
    },
    {
      "type": "range",
      "id": "ss_text_scale",
      "label": "גודל טקסט",
      "min": 80,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "ss_radius",
      "label": "פינות של כפתורים וכרטיסים",
      "options": [
        {
          "value": "theme",
          "label": "כמו בשאר האתר"
        },
        {
          "value": "square",
          "label": "ישרות"
        },
        {
          "value": "soft",
          "label": "מעוגלות מעט"
        },
        {
          "value": "round",
          "label": "מעוגלות"
        },
        {
          "value": "pill",
          "label": "עגולות לגמרי"
        }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "ss_custom_heading_font",
      "label": "פונט אחר לכותרות",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "ss_heading_font",
      "label": "פונט כותרות",
      "info": "לעברית: Assistant, Heebo, Rubik, Noto Sans Hebrew, Frank Ruhl Libre.",
      "default": "assistant_n7",
      "visible_if": "{{ section.settings.ss_custom_heading_font }}"
