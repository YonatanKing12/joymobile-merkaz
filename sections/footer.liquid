        },
        {
          "type": "richtext",
          "id": "text",
          "label": "טקסט נוסף"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "רשתות חברתיות",
          "default": true
        }
      ]
    },
    {
      "type": "social",
      "name": "רשתות חברתיות",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "כותרת",
          "default": "עקבו אחרינו"
        },
        {
          "type": "checkbox",
          "id": "show_whatsapp",
