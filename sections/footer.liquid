          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "טקסט",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "כותרת"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "טקסט",
          "default": "<p>משריינים באתר ואוספים באחד הסניפים באילת, במחירי אילת ללא מע״מ.</p>"
        }
