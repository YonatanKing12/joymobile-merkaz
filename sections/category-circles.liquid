          "type": "text",
          "id": "label",
          "label": "כיתוב",
          "info": "לא חובה. ברירת המחדל: שם הקטגוריה."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "עיגולי קטגוריות",
      "blocks": [
        {
          "type": "circle"
        },
        {
          "type": "circle"
        },
        {
          "type": "circle"
        },
        {
          "type": "circle"
        },
        {
          "type": "circle"
        },
        {
          "type": "circle"
        },
        {
          "type": "circle"
        }
      ]
    }
  ]
}
