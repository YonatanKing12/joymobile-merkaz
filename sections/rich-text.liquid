{%- comment -%}
  Rich text: optional heading, formatted text and a button, on an optional light panel.
{%- endcomment -%}
{%- render 'section-style', section: section -%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    --rich-text-pad-top: {{ section.settings.padding_top }}px;
    --rich-text-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

<div class="rich-text rich-text--{{ section.settings.background }}">
  <div class="page-width{% if section.settings.width == 'narrow' %} page-width--narrow{% endif %}">
    <div class="rich-text__inner rich-text__inner--{{ section.settings.alignment }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text__heading rich-text__heading--{{ section.settings.heading_size }}">
          {{- section.settings.heading | escape -}}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rich-text__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a
          class="button rich-text__button{% if section.settings.button_style == 'accent' %} button--accent{% elsif section.settings.button_style == 'outline' %} button--outline{% endif %}"
          href="{{ section.settings.button_link }}"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "טקסט עשיר",
  "tag": "section",
  "class": "section-rich-text",
  "disabled_on": {
    "groups": [
      "header",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "כותרת"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "גודל הכותרת",
      "options": [
        {
          "value": "small",
          "label": "קטן"
        },
        {
          "value": "medium",
          "label": "בינוני"
        },
        {
          "value": "large",
          "label": "גדול"
        }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "טקסט",
      "default": "<p>כתבו כאן על החנות, על מבצע או על כל דבר שחשוב שהלקוחות ידעו.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "תווית כפתור"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "קישור הכפתור"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "סגנון הכפתור",
      "options": [
        {
          "value": "dark",
          "label": "שחור"
        },
        {
          "value": "accent",
          "label": "ירוק"
        },
        {
          "value": "outline",
          "label": "מסגרת"
        }
      ],
      "default": "dark"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "יישור",
      "options": [
        {
          "value": "start",
          "label": "לימין"
        },
        {
          "value": "center",
          "label": "למרכז"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "width",
      "label": "רוחב",
      "options": [
        {
          "value": "narrow",
          "label": "צר"
        },
        {
          "value": "page",
          "label": "רוחב העמוד"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "select",
      "id": "background",
      "label": "רקע",
      "options": [
        {
          "value": "none",
          "label": "ללא"
        },
        {
          "value": "surface",
          "label": "אפור בהיר"
        },
        {
          "value": "surface-alt",
          "label": "אפור"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "ריווח עליון",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "ריווח תחתון",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "עיצוב הסקשן"
    },
    {
      "type": "paragraph",
      "content": "כל מה שנשאר ריק לוקח את העיצוב הכללי של האתר (הגדרות התבנית › צבעים, טיפוגרפיה)."
    },
    {
      "type": "select",
      "id": "ss_visibility",
      "label": "איפה להציג את הסקשן",
      "options": [
        {
          "value": "all",
          "label": "במחשב ובטלפון"
        },
        {
          "value": "desktop",
          "label": "רק במחשב"
        },
        {
          "value": "mobile",
          "label": "רק בטלפון"
        }
      ],
      "default": "all"
    },
    {
      "type": "color_background",
      "id": "ss_background",
      "label": "רקע",
      "info": "צבע אחיד או מעבר צבעים (גרדיאנט)."
    },
    {
      "type": "color",
      "id": "ss_text_color",
      "label": "צבע טקסט"
    },
    {
      "type": "color",
      "id": "ss_heading_color",
      "label": "צבע כותרות"
    },
    {
      "type": "color",
      "id": "ss_accent_color",
      "label": "צבע הדגשה",
      "info": "קישורים, אייקונים ופרטים צבעוניים."
    },
    {
      "type": "color",
      "id": "ss_button_bg",
      "label": "צבע כפתורים"
    },
    {
      "type": "color",
      "id": "ss_button_text",
      "label": "צבע טקסט בכפתורים"
    },
    {
      "type": "range",
      "id": "ss_text_scale",
      "label": "גודל טקסט",
      "min": 80,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "ss_radius",
      "label": "פינות של כפתורים וכרטיסים",
      "options": [
        {
          "value": "theme",
          "label": "כמו בשאר האתר"
        },
        {
          "value": "square",
          "label": "ישרות"
        },
        {
          "value": "soft",
          "label": "מעוגלות מעט"
        },
        {
          "value": "round",
          "label": "מעוגלות"
        },
        {
          "value": "pill",
          "label": "עגולות לגמרי"
        }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "ss_custom_heading_font",
      "label": "פונט אחר לכותרות",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "ss_heading_font",
      "label": "פונט כותרות",
      "info": "פונטים עם עברית: Assistant, Rubik, Frank Ruhl Libre.",
      "default": "assistant_n7",
      "visible_if": "{{ section.settings.ss_custom_heading_font }}"
    },
    {
      "type": "checkbox",
      "id": "ss_custom_body_font",
      "label": "פונט אחר לטקסט",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "ss_body_font",
      "label": "פונט טקסט",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.ss_custom_body_font }}"
    }
  ],
  "presets": [
    {
      "name": "טקסט עשיר"
    }
  ]
}
{% endschema %}
