const Footer=()=>`<footer class="footer"><div class="wrap footer-inner"><div>${brand()}<p class="micro">${STORE_COPY.brandName}</p></div><div class="legal-links"><a href="${PRIVACY_URL}" target="_blank" rel="noopener noreferrer">מדיניות הפרטיות</a><button type="button" data-cookie-preferences>הגדרות עוגיות</button><a href="${TERMS_URL}" target="_blank" rel="noopener noreferrer">תנאי שימוש</a></div></div></footer>`;

const LEADS_ENDPOINT='https://script.google.com/macros/s/AKfycbxztQtXdk04iDv_b-ew8v59wYQOV6ZevbRaeVWbD4pa1DkMBwNNwEPcmU-H0qr0rCGZ/exec';
const CONSENT_VERSION='20260910-1';
// The receiver rejects any other source or privacy URL ({"accepted":false,"error":"invalid"}).
const PRIVACY_POLICY_URL='https://joymobile.konimbo.co.il/contract';
const LEAD_SOURCE='iphone18-launch-page';
const LEAD_FIELDS=['name','phone','email','color','tradeIn','contactMethod','marketingConsent'];
function normalizePhone(value){
 const raw=String(value).trim();
 if(!/^[+\d\s()-]+$/.test(raw))return '';
 let digits=raw.replace(/[\s()-]/g,'');
 if(digits.startsWith('+972'))digits='0'+digits.slice(4);
 else if(digits.startsWith('00972'))digits='0'+digits.slice(5);
 else if(digits.startsWith('972'))digits='0'+digits.slice(3);
 return /^05\d{8}$/.test(digits)?digits:'';
}
function validateLead(data){
 const errors={};
 const name=String(data.name||'').trim();
 if(name.length<2||name.length>100||!/[\p{L}]/u.test(name))errors.name='יש להזין שם מלא.';
 if(!normalizePhone(data.phone))errors.phone='יש להזין מספר נייד ישראלי תקין, למשל 050-1234567.';
 const email=String(data.email||'').trim();
 if(email.length>254||!/^[^\s@]+@[^\s@.]+(?:\.[^\s@.]+)+$/.test(email))errors.email='יש להזין כתובת אימייל תקינה.';
 if(!['undecided',...duoColors.map(c=>c.name)].includes(data.color))errors.color='יש לבחור צבע מועדף.';
 if(!['undecided','interested','not-relevant'].includes(data.tradeIn))errors.tradeIn='יש לבחור אפשרות טרייד-אין.';
 if(!['phone','whatsapp','sms'].includes(data.contactMethod))errors.contactMethod='יש לבחור דרך ליצירת קשר.';
 if(data.marketingConsent!=='yes')errors.marketingConsent='יש לסמן את תיבת האישור כדי לשלוח את הפרטים.';
 return errors;
}
// Reuse the same request for unchanged retries, without storing personal data on disk.
function createLeadRequest(){
 let previousKey,previousPayload;
 return data=>{
  const key=JSON.stringify(data);
  if(key!==previousKey){
   previousPayload={...data,requestId:crypto.randomUUID(),consentRecordedAt:new Date().toISOString()};
   previousKey=key;
  }
  return previousPayload;
 };
}
// Require a readable, matching receipt after persistence. Opaque responses never count.
async function submitLead(payload,fetcher=fetch){
 if(!LEADS_ENDPOINT||!payload.requestId)throw new Error('receiver-not-configured');
 const controller=new AbortController();
 const timeout=setTimeout(()=>controller.abort(),30000);
 try{
  const response=await fetcher(LEADS_ENDPOINT,{method:'POST',mode:'cors',credentials:'omit',redirect:'follow',referrerPolicy:'no-referrer',headers:{'Content-Type':'text/plain;charset=UTF-8','Accept':'application/json'},body:JSON.stringify(payload),signal:controller.signal});
  if(!response.ok)throw new Error('lead-not-accepted');
  if(!response.headers.get('content-type')?.includes('application/json'))throw new Error('invalid-receipt');
  const receipt=await response.json();
  if(receipt.accepted!==true||receipt.requestId!==payload.requestId)throw new Error('lead-not-accepted');
  return receipt;
 }finally{clearTimeout(timeout)}
}

