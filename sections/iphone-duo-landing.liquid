['האם ההרשמה מחייבת רכישה?','לא. ההרשמה מיועדת לקבלת עדכונים וליצירת קשר לקראת פתיחת המכירה, ללא התחייבות לרכישה.'],['האם אפשר לציין טרייד-אין?','כן. תוכלו לציין בטופס אם תרצו לבדוק אפשרות לטרייד-אין, והנציג יוכל להתייחס לכך בהמשך.'],STORE_COPY.priceFaq,['מתי תיפתח המכירה?','נעדכן את הנרשמים ברגע שהמכירה תיפתח ויהיו פרטים מאושרים לגבי זמינות ומחירים.'],['האם ניתן לבחור צבע מראש?','כן. ניתן לציין צבע מועדף בטופס, בכפוף לזמינות בפועל עם פתיחת המכירה.']
].map(([q,a],i)=>`<article class="faq-item"><h3><button type="button" id="question-${i}" aria-expanded="false" aria-controls="answer-${i}">${q}<span aria-hidden="true">+</span></button></h3><div class="faq-answer" id="answer-${i}" role="region" aria-labelledby="question-${i}" inert><div><p>${a}</p></div></div></article>`).join('')}</div></div></section>`;
const FinalCTA=()=>`<section class="final-cta" aria-labelledby="final-title"><div class="wrap reveal"><h2 id="final-title"><span class="final-title-product">ה-<bdi>iPhone</bdi></span> <span class="final-title-message">הבא שלכם מתחיל בג׳וי</span></h2><p>הצטרפו לרשימת העדכונים של <bdi>JOY MOBILE</bdi>.</p><a class="button" href="#lead">אני רוצה להיות בין הראשונים${arrow}</a></div></section>`;
const Footer=()=>`<footer class="footer"><div class="wrap footer-inner"><div>${brand()}<p class="micro">${STORE_COPY.brandName}</p></div><div class="legal-links"><a href="${PRIVACY_URL}" target="_blank" rel="noopener noreferrer">מדיניות הפרטיות</a><a href="${TERMS_URL}" target="_blank" rel="noopener noreferrer">תנאי שימוש</a></div></div></footer>`;

const LEADS_ENDPOINT='https://script.google.com/macros/s/AKfycbxztQtXdk04iDv_b-ew8v59wYQOV6ZevbRaeVWbD4pa1DkMBwNNwEPcmU-H0qr0rCGZ/exec';
const CONSENT_VERSION='20260910-1';
// The receiver rejects any other source or privacy URL ({"accepted":false,"error":"invalid"}).
const PRIVACY_POLICY_URL='https://joymobile.konimbo.co.il/contract';
const LEAD_SOURCE='iphone18-launch-page';
const LEAD_FIELDS=['name','phone','email','color','tradeIn','contactMethod','marketingConsent'];
function normalizePhone(value){
 const raw=String(value).trim();
 if(!/^[+\d\s()-]+$/.test(raw))return '';
 let digits=raw.replace(/[\s()-]/g,'');
 if(digits.startsWith('+972'))digits='0'+digits.slice(4);
 else if(digits.startsWith('00972'))digits='0'+digits.slice(5);
 else if(digits.startsWith('972'))digits='0'+digits.slice(3);
 return /^05\d{8}$/.test(digits)?digits:'';
}
function validateLead(data){
 const errors={};
 const name=String(data.name||'').trim();
 if(name.length<2||name.length>100||!/[\p{L}]/u.test(name))errors.name='יש להזין שם מלא.';
 if(!normalizePhone(data.phone))errors.phone='יש להזין מספר נייד ישראלי תקין, למשל 050-1234567.';
 const email=String(data.email||'').trim();
 if(email.length>254||!/^[^\s@]+@[^\s@.]+(?:\.[^\s@.]+)+$/.test(email))errors.email='יש להזין כתובת אימייל תקינה.';
 if(!['undecided',...duoColors.map(c=>c.name)].includes(data.color))errors.color='יש לבחור צבע מועדף.';
 if(!['undecided','interested','not-relevant'].includes(data.tradeIn))errors.tradeIn='יש לבחור אפשרות טרייד-אין.';
 if(!['phone','whatsapp','sms'].includes(data.contactMethod))errors.contactMethod='יש לבחור דרך ליצירת קשר.';
 if(data.marketingConsent!=='yes')errors.marketingConsent='יש לסמן את תיבת האישור כדי לשלוח את הפרטים.';
 return errors;
}
// Reuse the same request for unchanged retries, without storing personal data on disk.
function createLeadRequest(){
 let previousKey,previousPayload;
 return data=>{
  const key=JSON.stringify(data);
  if(key!==previousKey){
   previousPayload={...data,requestId:crypto.randomUUID(),consentRecordedAt:new Date().toISOString()};
   previousKey=key;
  }
  return previousPayload;
 };
}
// Require a readable, matching receipt after persistence. Opaque responses never count.
async function submitLead(payload,fetcher=fetch){
 if(!LEADS_ENDPOINT||!payload.requestId)throw new Error('receiver-not-configured');
 const controller=new AbortController();
 const timeout=setTimeout(()=>controller.abort(),30000);
 try{
  const response=await fetcher(LEADS_ENDPOINT,{method:'POST',mode:'cors',credentials:'omit',redirect:'follow',referrerPolicy:'no-referrer',headers:{'Content-Type':'text/plain;charset=UTF-8','Accept':'application/json'},body:JSON.stringify(payload),signal:controller.signal});
  if(!response.ok)throw new Error('lead-not-accepted');
  if(!response.headers.get('content-type')?.includes('application/json'))throw new Error('invalid-receipt');
  const receipt=await response.json();
  if(receipt.accepted!==true||receipt.requestId!==payload.requestId)throw new Error('lead-not-accepted');
  return receipt;
 }finally{clearTimeout(timeout)}
}

const small = src => src.replace('_large.jpg','_small_2x.jpg');
const swatches = family => `<fieldset class="pv-swatches"><legend class="pv-sr">צבע ${family.title}</legend>${family.colors.map((c,i)=>`<label class="pv-swatch" title="${c.label} — ${c.name}"><input type="radio" name="${family.id}-color" value="${c.name}" ${i===0?'checked':''}><span style="--swatch:${c.hex}"></span><span class="pv-sr">${c.label} — ${c.name}</span></label>`).join('')}</fieldset><p class="pv-color-label" aria-live="polite"><bdi>${family.colors[0].name}</bdi> · ${family.colors[0].label}</p>`;
const specs = family => `<details class="pv-specs"><summary>מפרט טכני<span aria-hidden="true">+</span></summary><div class="pv-spec-content"><p class="pv-source-note">נתוני Apple מהעמוד האמריקאי, נבדקו ב־10.09.2026. זמינות דגמים, צבעים, נפחים ותכונות בישראל תימסר עם פתיחת המכירה.</p>${SPECS.map(([title,rows])=>`<details class="pv-spec-group"><summary>${title}<span aria-hidden="true">+</span></summary><div class="pv-table-wrap"><table><caption class="pv-sr">${title} — ${family.title}</caption><thead><tr><th scope="col">מאפיין</th><th scope="col"><bdi>${family.title}</bdi></th></tr></thead><tbody>${rows.map(([label,value])=>`<tr><th scope="row">${label}</th><td>${value}</td></tr>`).join('')}</tbody></table></div></details>`).join('')}<p class="pv-source-note">גודל המסך נמדד באלכסון כמלבן; שטח הצפייה בפועל קטן יותר. אחסון זמין בפועל קטן מהנפח הנקוב. עמידות למים וזמני סוללה וטעינה תלויים בתנאים. <a href="${family.specSource}" target="_blank" rel="noopener noreferrer">למפרט המקור, תדרי הרשת, כל התכונות והערות הבדיקה של Apple ↗</a></p></div></details>`;

function ProductViewer(f){
 return `<section id="product-viewer" class="product-explorer section-space" aria-labelledby="explorer-title"><div class="wrap"><div class="section-heading"><h2 id="explorer-title">הכל בפרטים</h2><p>בחרו צבע, גלו את התכונות ועיינו במפרט.</p></div><article id="viewer-${f.id}" class="pv-family pv-${f.id}" aria-labelledby="pv-title-${f.id}"><div class="pv-heading"><div><h3 id="pv-title-${f.id}" dir="ltr">${f.title}</h3><p>${f.subtitle}</p></div></div><div class="pv-stage" data-family="${f.id}"><picture class="pv-picture" data-colors="true"><source media="(max-width:900px)" srcset="${small(f.colors[0].image)}"><img class="pv-image" src="${f.colors[0].image}" alt="${f.title} בצבע ${f.colors[0].name}" width="1440" height="760" loading="lazy" decoding="async"></picture><p class="pv-image-error" hidden role="status">התמונה לא נטענה. <button type="button" class="pv-retry">ניסיון נוסף</button></p><div class="pv-controls" aria-label="תכונות ${f.title}">${f.features.map((feature,i)=>`<div class="pv-feature ${i===0?'is-open':''}"><h4><button type="button" class="pv-feature-button" id="pv-${f.id}-button-${i}" aria-expanded="${i===0}" aria-controls="pv-${f.id}-panel-${i}" data-feature="${i}"><span class="pv-plus" aria-hidden="true">${i===0?'−':'+'}</span>${feature.title}</button></h4><div class="pv-feature-panel" id="pv-${f.id}-panel-${i}" role="region" aria-labelledby="pv-${f.id}-button-${i}" ${i===0?'':'hidden'}><p>${feature.text}</p>${feature.color?swatches(f):''}</div></div>`).join('')}</div></div><div class="pv-bottom"><p class="pv-choice" aria-live="polite"><bdi>${f.title}</bdi> · <bdi>${f.colors[0].name}</bdi></p><a href="#lead" class="button pv-choose" data-choose-family="${f.id}">מעניין אותי הדגם הזה <span aria-hidden="true">←</span></a></div>${specs(f)}<p class="pv-credit">תמונות ונתוני מוצר: <a href="${f.source}" target="_blank" rel="noopener noreferrer">Apple ↗</a></p></article></div></section>`;
}

function initializeProductViewer(f,onChoose){
 const root=document.querySelector(`#viewer-${f.id}`);
 const image=root.querySelector('.pv-image');
 const picture=root.querySelector('.pv-picture');
 const error=root.querySelector('.pv-image-error');
 const buttons=[...root.querySelectorAll('[data-feature]')];
 let featureIndex=0,color=f.colors[0];
 const updateChoice=()=>{
  root.querySelector('.pv-choice').textContent=`${f.title} · ${color.name}`;
  root.querySelector('.pv-color-label').textContent=`${color.name} · ${color.label}`;
 };
 const updateImage=()=>{
  const feature=f.features[featureIndex];
  const src=feature.color?color.image:feature.image;
  error.hidden=true;
  picture.dataset.colors=String(!!feature.color);
  image.alt=feature.color?`${f.title} בצבע ${color.name}`:`${f.title} — ${feature.title}`;
  picture.querySelector('source').srcset=small(src);
  image.src=src;
 };
 image.addEventListener('error',()=>{error.hidden=false});
 image.addEventListener('load',()=>{error.hidden=true});
 root.querySelector('.pv-retry').addEventListener('click',updateImage);
 const activate=index=>{
  featureIndex=index;
  buttons.forEach((button,i)=>{
   const open=i===index;
   button.setAttribute('aria-expanded',String(open));
   button.querySelector('.pv-plus').textContent=open?'−':'+';
   button.closest('.pv-feature').classList.toggle('is-open',open);
   document.getElementById(button.getAttribute('aria-controls')).hidden=!open;
  });
  updateImage();
 };
 buttons.forEach((button,i)=>{
  button.addEventListener('click',()=>activate(i));
  button.addEventListener('keydown',event=>{
   let next;
   if(event.key==='ArrowDown')next=(i+1)%buttons.length;
   else if(event.key==='ArrowUp')next=(i+buttons.length-1)%buttons.length;
   else if(event.key==='Home')next=0;
   else if(event.key==='End')next=buttons.length-1;
   else return;
   event.preventDefault();buttons[next].focus();activate(next);
  });
 });
 root.querySelectorAll('.pv-swatches input').forEach(input=>input.addEventListener('change',()=>{
  color=f.colors.find(c=>c.name===input.value);updateChoice();updateImage();
 }));
 root.querySelector('.pv-choose').addEventListener('click',()=>onChoose(color.name));
}

const state={submitting:false};
document.querySelector('#app').innerHTML=Header()+'<main>'+Hero()+Benefits()+ProductViewer(duo)+FAQ()+FinalCTA()+'</main>'+Footer();
const form=document.querySelector('#lead-form');
const prepareLead=createLeadRequest();
const honeypot=document.createElement('input');
honeypot.type='text';honeypot.name='website';honeypot.tabIndex=-1;honeypot.autocomplete='off';
honeypot.setAttribute('aria-hidden','true');honeypot.style.cssText='position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;overflow:hidden';
form.append(honeypot);
// "מעניין אותי הדגם הזה" in the viewer carries the colour shown there into the form.
function selectColor(color){
 if(duoColors.some(c=>c.name===color))form.elements.color.value=color;
}
initializeProductViewer(duo,selectColor);
function showFieldError(key,message){const input=form.elements[key];input.setAttribute('aria-invalid',message?'true':'false');document.getElementById(key+'-error').textContent=message||'';}
LEAD_FIELDS.forEach(key=>{
 const input=form.elements[key];input.addEventListener('blur',()=>showFieldError(key,validateLead(Object.fromEntries(new FormData(form)))[key]));
 input.addEventListener('input',()=>{if(input.getAttribute('aria-invalid')==='true')showFieldError(key,validateLead(Object.fromEntries(new FormData(form)))[key])});
 input.addEventListener('change',()=>{if(input.getAttribute('aria-invalid')==='true')showFieldError(key,validateLead(Object.fromEntries(new FormData(form)))[key])});
});
form.addEventListener('submit',async event=>{
 event.preventDefault();if(state.submitting)return;
 const data=Object.fromEntries(new FormData(form));const errors=validateLead(data);
 LEAD_FIELDS.forEach(key=>showFieldError(key,errors[key]));
 if(Object.keys(errors).length){form.elements[Object.keys(errors)[0]].focus();return}
 const payload=prepareLead({name:data.name.trim(),phone:normalizePhone(data.phone),email:data.email.trim(),device:DEVICE,color:data.color,tradeIn:data.tradeIn,contactMethod:data.contactMethod,marketingConsent:true,consentDefault:'prechecked',consentVersion:CONSENT_VERSION,privacyPolicyUrl:PRIVACY_POLICY_URL,source:LEAD_SOURCE,website:data.website||''});
 state.submitting=true;const submit=form.querySelector('[type=submit]');const label=submit.querySelector('.submit-label');const error=document.querySelector('#submit-error');
 submit.disabled=true;label.textContent='שולחים את הפרטים…';form.setAttribute('aria-busy','true');error.hidden=true;
 try{await submitLead(payload);form.hidden=true;const success=document.querySelector('#success');success.hidden=false;success.focus();}
 catch{error.textContent='לא התקבל אישור קליטה. הפרטים שמילאתם נשמרו בטופס — נסו לשלוח שוב.';error.hidden=false;}
 finally{state.submitting=false;submit.disabled=false;label.textContent='שמרו לי מקום בהשקה';form.setAttribute('aria-busy','false')}
});
const faqButtons=[...document.querySelectorAll('.faq-item button')];
faqButtons.forEach((button,index)=>{
 button.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')!=='true';faqButtons.forEach(other=>{const active=other===button&&open;other.setAttribute('aria-expanded',String(active));other.closest('.faq-item').classList.toggle('open',active);document.getElementById(other.getAttribute('aria-controls')).inert=!active})});
 button.addEventListener('keydown',event=>{let i;if(event.key==='ArrowDown')i=(index+1)%faqButtons.length;else if(event.key==='ArrowUp')i=(index+faqButtons.length-1)%faqButtons.length;else if(event.key==='Home')i=0;else if(event.key==='End')i=faqButtons.length-1;else return;event.preventDefault();faqButtons[i].focus()});
});
const header=document.querySelector('.header');const updateHeader=()=>header.classList.toggle('scrolled',window.scrollY>25);window.addEventListener('scroll',updateHeader,{passive:true});updateHeader();
document.querySelectorAll('a[href="#lead"]').forEach(link=>link.addEventListener('click',()=>{setTimeout(()=>{if(!form.hidden)form.elements.name.focus({preventScroll:true})},matchMedia('(prefers-reduced-motion: reduce)').matches?0:600)}));
if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&'IntersectionObserver'in window){document.body.classList.add('motion-ready');const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target)}}),{threshold:.07});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));}
</script>

