const swatches = family => `<fieldset class="pv-swatches"><legend class="pv-sr">צבע ${family.title}</legend>${family.colors.map((c,i)=>`<label class="pv-swatch" title="${c.label} (${c.name})"><input type="radio" name="${family.id}-color" value="${c.name}" ${i===0?'checked':''}><span style="--swatch:${c.hex}"></span><span class="pv-sr">${c.label} ${c.name}</span></label>`).join('')}</fieldset><p class="pv-color-label" aria-live="polite"><bdi>${family.colors[0].name}</bdi> ${family.colors[0].label}</p>`;
const specs = family => `<details class="pv-specs"><summary>מפרט טכני<span aria-hidden="true">+</span></summary><div class="pv-spec-content"><p class="pv-source-note">נתוני Apple מהעמוד האמריקאי, נבדקו ב־10.09.2026. זמינות דגמים, צבעים, נפחים ותכונות בישראל תימסר עם פתיחת המכירה.</p>${SPECS.map(([title,rows])=>`<details class="pv-spec-group"><summary>${title}<span aria-hidden="true">+</span></summary><div class="pv-table-wrap"><table><caption class="pv-sr">${title} ${family.title}</caption><thead><tr><th scope="col">מאפיין</th><th scope="col"><bdi>${family.title}</bdi></th></tr></thead><tbody>${rows.map(([label,value])=>`<tr><th scope="row">${label}</th><td>${value}</td></tr>`).join('')}</tbody></table></div></details>`).join('')}<p class="pv-source-note">גודל המסך נמדד באלכסון כמלבן; שטח הצפייה בפועל קטן יותר. אחסון זמין בפועל קטן מהנפח הנקוב. עמידות למים וזמני סוללה וטעינה תלויים בתנאים. <a href="${family.specSource}" target="_blank" rel="noopener noreferrer">למפרט המקור, תדרי הרשת, כל התכונות והערות הבדיקה של Apple ↗</a></p></div></details>`;

