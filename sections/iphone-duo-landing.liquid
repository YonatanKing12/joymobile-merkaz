function imageFrameStyles(src){
 const key=src.split('/').pop().replace(/_(?:large|small_2x)\.jpg$/,'');
 const frame=IMAGE_FRAMES[key];
 if(!frame)return '';
 return Object.entries(frame).flatMap(([size,values])=>Object.entries(values).map(([name,value])=>`--frame-${name}-${size}:${value}${name==='ratio'?'':'%'}`)).join(';');
}

function ProductViewer(f){
 return `<section id="product-viewer" class="product-explorer section-space" aria-labelledby="explorer-title"><div class="wrap"><div class="section-heading"><h2 id="explorer-title">צבעים ותמונות המכשיר</h2></div><article id="viewer-${f.id}" class="pv-family pv-${f.id}" aria-labelledby="pv-title-${f.id}"><div class="pv-heading"><div><h3 id="pv-title-${f.id}" dir="ltr">${f.title}</h3></div><div class="pv-color-picker">${swatches(f)}</div></div><div class="pv-controls" role="tablist" aria-label="תכונות ${f.title}">${f.features.map((feature,i)=>`<button type="button" class="pv-feature-button" role="tab" id="pv-${f.id}-button-${i}" aria-selected="${i===0}" aria-controls="pv-${f.id}-panel-${i}" tabindex="${i===0?0:-1}" data-feature="${i}">${feature.title}</button>`).join('')}</div><div class="pv-stage" data-family="${f.id}"><picture class="pv-picture" data-colors="true" style="${imageFrameStyles(f.colors[0].image)}"><source media="(max-width:760px)" srcset="${small(f.colors[0].image)}"><img class="pv-image" src="${f.colors[0].image}" alt="${f.title} בצבע ${f.colors[0].name}" width="1440" height="760" loading="lazy" decoding="async"></picture><div class="pv-image-error" hidden role="status"><p>התמונה לא נטענה.</p><button type="button" class="pv-retry">ניסיון נוסף</button></div>${f.features.map((feature,i)=>`<div class="pv-feature-panel" id="pv-${f.id}-panel-${i}" role="tabpanel" tabindex="0" aria-labelledby="pv-${f.id}-button-${i}" ${i===0?'':'hidden'}><h4>${feature.title}</h4><p>${feature.text}</p></div>`).join('')}</div><div class="pv-bottom"><p class="pv-choice" aria-live="polite"><bdi>${f.title}</bdi> <bdi>${f.colors[0].name}</bdi></p><a href="#lead" class="button pv-choose" data-choose-family="${f.id}">עדכנו אותי על הצבע הזה ${arrow}</a></div>${specs(f)}<p class="pv-credit">תמונות ונתוני מוצר: <a href="${f.source}" target="_blank" rel="noopener noreferrer">Apple ↗</a></p></article></div></section>`;
}

function initializeProductViewer(f,onChoose){
 const root=document.querySelector(`#viewer-${f.id}`);
 const image=root.querySelector('.pv-image');
 const picture=root.querySelector('.pv-picture');
 const error=root.querySelector('.pv-image-error');
 const buttons=[...root.querySelectorAll('[data-feature]')];
 let featureIndex=0,color=f.colors[0];
 const updateChoice=()=>{
  root.querySelector('.pv-choice').textContent=`${f.title} ${color.name}`;
  root.querySelector('.pv-color-label').textContent=`${color.name} ${color.label}`;
 };
 const updateImage=()=>{
  const feature=f.features[featureIndex];
  const src=feature.color?color.image:feature.image;
  error.hidden=true;
  picture.dataset.colors=String(!!feature.color);
  picture.style.cssText=imageFrameStyles(src);
  picture.classList.add('is-loading');
  image.alt=feature.color?`${f.title} בצבע ${color.name}`:`${f.title} ${feature.title}`;
  picture.querySelector('source').srcset=small(src);
  image.src=src;
 };
 image.addEventListener('error',()=>{picture.classList.remove('is-loading');error.hidden=false});
 image.addEventListener('load',()=>{picture.classList.remove('is-loading');error.hidden=true});
 root.querySelector('.pv-retry').addEventListener('click',()=>{
  // Force a new browser request after a failed cached response.
  const feature=f.features[featureIndex],src=feature.color?color.image:feature.image;
  const nonce=`retry=${Date.now()}`;
  error.hidden=true;picture.classList.add('is-loading');
  picture.querySelector('source').srcset=small(src)+'?'+nonce;
  image.src=src+'?'+nonce;
 });
 const activate=index=>{
  featureIndex=index;
  buttons.forEach((button,i)=>{
   const active=i===index;
   button.setAttribute('aria-selected',String(active));
   button.tabIndex=active?0:-1;
   document.getElementById(button.getAttribute('aria-controls')).hidden=!active;
  });
  // Move only the tab rail, never the page, when selecting an off-screen feature.
  const rail=root.querySelector('.pv-controls'),tab=buttons[index];
  const railRect=rail.getBoundingClientRect(),tabRect=tab.getBoundingClientRect();
  if(tabRect.left<railRect.left+8)rail.scrollLeft+=tabRect.left-railRect.left-8;
  else if(tabRect.right>railRect.right-8)rail.scrollLeft+=tabRect.right-railRect.right+8;
  updateImage();
 };
 buttons.forEach((button,i)=>{
  button.addEventListener('click',()=>activate(i));
  button.addEventListener('keydown',event=>{
   let next;
   if(event.key==='ArrowLeft')next=(i+1)%buttons.length;
   else if(event.key==='ArrowRight')next=(i+buttons.length-1)%buttons.length;
   else if(event.key==='Home')next=0;
   else if(event.key==='End')next=buttons.length-1;
   else return;
   event.preventDefault();buttons[next].focus({preventScroll:true});activate(next);
  });
 });
 root.querySelectorAll('.pv-swatches input').forEach(input=>input.addEventListener('change',()=>{
  color=f.colors.find(c=>c.name===input.value);updateChoice();activate(0);onChoose(color.name);
 }));
 root.querySelector('.pv-choose').addEventListener('click',()=>onChoose(color.name));
}

const state={submitting:false};
document.querySelector('#app').innerHTML=Header()+'<main>'+Hero()+Benefits()+ProductViewer(duo)+FAQ()+'</main>'+Footer();
const form=document.querySelector('#lead-form');
const prepareLead=createLeadRequest();
form.elements.contactMethod.addEventListener('change',()=>{
 const method={phone:'בטלפון',whatsapp:'בוואטסאפ',sms:'באמצעות מסרון'}[form.elements.contactMethod.value];
 document.querySelector('.lead-contact-note').textContent=`ניצור קשר ${method} עם פתיחת המכירה`;
});
const honeypot=document.createElement('input');
honeypot.type='text';honeypot.name='website';honeypot.tabIndex=-1;honeypot.autocomplete='off';
honeypot.setAttribute('aria-hidden','true');honeypot.style.cssText='position:absolute;width:1px;height:1px;opacity:0;pointer-events:none;overflow:hidden';
form.append(honeypot);
// Explicit color choices carry into the registration form.
function selectColor(color){
 if(duoColors.some(c=>c.name===color)){form.elements.color.value=color;form.elements.color.dispatchEvent(new Event('change',{bubbles:true}));document.querySelector('.lead-preference-choice').textContent=duoColors.find(c=>c.name===color).label;}
}
initializeProductViewer(duo,selectColor);
function showFieldError(key,message){const input=form.elements[key];input.setAttribute('aria-invalid',message?'true':'false');document.getElementById(key+'-error').textContent=message||'';}
LEAD_FIELDS.forEach(key=>{
 const input=form.elements[key];input.addEventListener('blur',()=>showFieldError(key,validateLead(Object.fromEntries(new FormData(form)))[key]));
 input.addEventListener('input',()=>{if(input.getAttribute('aria-invalid')==='true')showFieldError(key,validateLead(Object.fromEntries(new FormData(form)))[key])});
 input.addEventListener('change',()=>{if(input.getAttribute('aria-invalid')==='true')showFieldError(key,validateLead(Object.fromEntries(new FormData(form)))[key])});
});
form.addEventListener('submit',async event=>{
 event.preventDefault();if(state.submitting)return;
 const data=Object.fromEntries(new FormData(form));const errors=validateLead(data);
 LEAD_FIELDS.forEach(key=>showFieldError(key,errors[key]));
 if(Object.keys(errors).length){form.elements[Object.keys(errors)[0]].focus();return}
 const payload=prepareLead({name:data.name.trim(),phone:normalizePhone(data.phone),email:data.email.trim(),device:DEVICE,color:data.color,tradeIn:data.tradeIn,contactMethod:data.contactMethod,marketingConsent:true,consentDefault:'unchecked',consentVersion:CONSENT_VERSION,privacyPolicyUrl:PRIVACY_POLICY_URL,source:LEAD_SOURCE,website:data.website||''});
 state.submitting=true;const submit=form.querySelector('[type=submit]');const label=submit.querySelector('.submit-label');const error=document.querySelector('#submit-error');
 submit.disabled=true;label.textContent='שולחים את הפרטים…';form.setAttribute('aria-busy','true');error.hidden=true;
 try{await submitLead(payload);form.hidden=true;const success=document.querySelector('#success');success.hidden=false;success.focus();}
 catch{error.textContent='לא התקבל אישור קליטה. הפרטים שמילאתם נשמרו בטופס נסו לשלוח שוב.';error.hidden=false;}
 finally{state.submitting=false;submit.disabled=false;label.textContent='שליחת הפרטים';form.setAttribute('aria-busy','false')}
});
const faqButtons=[...document.querySelectorAll('.faq-item button')];
faqButtons.forEach((button,index)=>{
 button.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')!=='true';faqButtons.forEach(other=>{const active=other===button&&open;other.setAttribute('aria-expanded',String(active));other.closest('.faq-item').classList.toggle('open',active);document.getElementById(other.getAttribute('aria-controls')).inert=!active})});
 button.addEventListener('keydown',event=>{let i;if(event.key==='ArrowDown')i=(index+1)%faqButtons.length;else if(event.key==='ArrowUp')i=(index+faqButtons.length-1)%faqButtons.length;else if(event.key==='Home')i=0;else if(event.key==='End')i=faqButtons.length-1;else return;event.preventDefault();faqButtons[i].focus()});
});
const header=document.querySelector('.header');const updateHeader=()=>header.classList.toggle('scrolled',window.scrollY>25);window.addEventListener('scroll',updateHeader,{passive:true});updateHeader();
const measureHeader=()=>document.documentElement.style.setProperty('--landing-header-height',header.getBoundingClientRect().height+'px');
measureHeader();
if('ResizeObserver' in window)new ResizeObserver(measureHeader).observe(header);
else window.addEventListener('resize',measureHeader,{passive:true});
document.querySelectorAll('a[href="#lead"]').forEach(link=>link.addEventListener('click',()=>{
 const target=document.querySelector('#lead');target.tabIndex=-1;target.focus({preventScroll:true});
}));

</script>

