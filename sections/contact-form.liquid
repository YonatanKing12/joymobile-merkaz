{%- comment -%}
  Contact form (Shopify `contact` form → an email to the store) with the store's
  contact details beside it. Konimbo layout: the form column at the inline-start
  (400px at 1440) and the details column next to it; stacked on mobile, form first.

  Fields as measured: name, phone, email, message — all required, labels above the
  inputs, "*" marker, the submit button at the inline-start. Fixed: real <label for>,
  visible focus (base.css), autocomplete, a server-side error summary (role="alert",
  links to the fields) and a success message (role="status"), a client-side mark
  on a bad field (red border + message under it, CSS :user-invalid, as Konimbo did
  on submit), a real submit <button>, and no pre-checked marketing box (the
  optional one is unchecked and only adds a line to the email; Shopify's contact
  form does not subscribe anyone).
  Theme builders never submit this form (it emails the store).

  Contact details come from the theme settings (יצירת קשר ורשתות חברתיות), so the
  footer, the structured data and this page always agree.

  "סוג הטופס" (form_kind) swaps the fields between name/phone/email and the consent:
  - contact: the message (required).
  - repair (JOY FIX intake, templates/page.joy-fix.json): device, fault type, preferred
    branch (the "branch" metaobject entries, snippets/branch-order; left out when there are
    none) and an optional description.
  - trade_in (templates/page.trade-in.json): device, condition, storage, optional details.
  repair and trade_in add a hidden contact[subject], so the store's inbox can sort the
  emails. Every field is named by its Hebrew label: that is what the notification email shows.
  An optional WhatsApp button (show_whatsapp) offers the same request as a chat, with a
  message pre-filled for the form type.
{%- endcomment -%}
{{ 'section-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign required_mark = '<span class="contact-form__req" aria-hidden="true">*</span>'

  assign form_kind = section.settings.form_kind | default: 'contact'

  # tel: link from the same rules as the WhatsApp link (snippets/phone-href).
  assign phone_display = settings.contact_phone | strip
  capture phone_href
    render 'phone-href', phone: phone_display
  endcapture

  capture whatsapp_url
    render 'whatsapp-url', text: settings.contact_whatsapp_message
  endcapture

  # The WhatsApp alternative under the form: its own number when set, a message for the form type.
  assign form_whatsapp_url = ''
  if section.settings.show_whatsapp
    assign form_whatsapp_text = section.settings.whatsapp_message | strip
    if form_whatsapp_text == blank
      case form_kind
        when 'repair'
          assign form_whatsapp_text = 'contact.repair.whatsapp_message' | t
        when 'trade_in'
          assign form_whatsapp_text = 'contact.trade_in.whatsapp_message' | t
        else
          assign form_whatsapp_text = settings.contact_whatsapp_message
      endcase
    endif
    capture form_whatsapp_url
      render 'whatsapp-url', text: form_whatsapp_text, phone: section.settings.whatsapp_number
    endcapture
  endif

  assign body_required = true
  assign body_label = 'contact.form.body' | t
  if form_kind == 'repair'
    assign body_required = false
    assign body_label = 'contact.repair.description' | t
    assign form_subject = 'contact.repair.subject' | t

    capture branch_order
      render 'branch-order'
    endcapture
    assign branch_order = branch_order | split: ','
  elsif form_kind == 'trade_in'
    assign body_required = false
    assign body_label = 'contact.trade_in.details' | t
    assign form_subject = 'contact.trade_in.subject' | t
  endif

  capture whatsapp_display
    render 'whatsapp-url', format: 'display'
  endcapture

  assign address = settings.store_street | strip
  assign city = settings.store_city | strip
  if city != blank
    if address != blank
      assign address = address | append: ', '
    endif
    assign address = address | append: city
  endif

  assign new_window = 'accessibility.new_window' | t

  assign submit_label = section.settings.submit_label | strip
  if submit_label == blank
    assign submit_label = 'contact.form.submit' | t
  endif
-%}

<div class="contact page-width">
  <div class="contact__grid{% unless section.settings.show_info %} contact__grid--single{% endunless %}">
    <div class="contact__form-col">
      {%- if section.settings.heading != blank -%}
        <h2 class="contact__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="contact__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}

      {%- form 'contact', id: form_id, class: 'contact-form' -%}
        {%- liquid
          assign email_invalid = false
          assign body_invalid = false
          if form.errors
            if form.errors contains 'email'
              assign email_invalid = true
            endif
            if form.errors contains 'body'
              assign body_invalid = true
            endif
          endif
        -%}

        {%- if form.posted_successfully? -%}
          <div class="contact-form__status form-message form-message--success" role="status" tabindex="-1" autofocus>
            {%- render 'icon', name: 'check', size: 20 -%}
            <p>{{ 'contact.form.success' | t }}</p>
          </div>
        {%- elsif form.errors -%}
          <div class="contact-form__errors" role="alert" tabindex="-1" autofocus>
            <p class="form-message form-message--error">
              {%- render 'icon', name: 'alert', size: 20 -%}
              <span>{{ 'errors.form_heading' | t }}</span>
            </p>
            <ul class="contact-form__error-list">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#{{ form_id }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <p class="contact-form__required-note">{{ 'contact.form.required_note' | t }}</p>

        <div class="field">
          <label class="field__label" for="{{ form_id }}-name">{{ 'contact.form.name' | t }} {{ required_mark }}</label>
          <input
            class="input"
            type="text"
            id="{{ form_id }}-name"
            name="contact[{{ 'contact.form.name' | t }}]"
            autocomplete="name"
            required
            value="{% if customer %}{{ customer.name | escape }}{% endif %}"
          >
          <p class="form-message form-message--error contact-form__error">
            {%- render 'icon', name: 'alert', size: 16 -%}
            <span>{{ 'errors.required' | t }}</span>
          </p>
        </div>

        {%- if section.settings.show_phone -%}
          <div class="field">
            <label class="field__label" for="{{ form_id }}-phone">
              {{- 'contact.form.phone' | t -}}
              {%- if section.settings.phone_required %} {{ required_mark }}{% endif -%}
            </label>
            <input
              class="input"
              type="tel"
              id="{{ form_id }}-phone"
              name="contact[{{ 'contact.form.phone' | t }}]"
              autocomplete="tel"
              inputmode="tel"
              pattern="\+?[0-9\s\-\(\)]{9,20}"
              title="{{ 'contact.form.phone_invalid' | t }}"
              aria-describedby="{{ form_id }}-phone-hint"
              {% if section.settings.phone_required %}required{% endif %}
              value="{% if customer.phone %}{{ customer.phone | escape }}{% endif %}"
            >
            <p class="field__hint" id="{{ form_id }}-phone-hint">{{ 'contact.form.phone_hint' | t }}</p>
            <p class="form-message form-message--error contact-form__error">
              {%- render 'icon', name: 'alert', size: 16 -%}
              <span>{{ 'errors.phone' | t }}</span>
            </p>
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="{{ form_id }}-email">{{ 'contact.form.email' | t }} {{ required_mark }}</label>
          <input
            class="input"
            type="email"
            id="{{ form_id }}-email"
            name="contact[email]"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            {% if email_invalid %}aria-invalid="true"{% endif %}
            value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
          >
          <p class="form-message form-message--error contact-form__error">
            {%- render 'icon', name: 'alert', size: 16 -%}
            <span>{{ 'errors.email' | t }}</span>
          </p>
        </div>

        {%- if form_kind == 'repair' -%}
          <input type="hidden" name="contact[subject]" value="{{ form_subject | escape }}">

          <div class="field">
            <label class="field__label" for="{{ form_id }}-device">{{ 'contact.repair.device' | t }} {{ required_mark }}</label>
            <input
              class="input"
              type="text"
              id="{{ form_id }}-device"
              name="contact[{{ 'contact.repair.device' | t | escape }}]"
              placeholder="{{ 'contact.repair.device_placeholder' | t }}"
              autocomplete="off"
              required
            >
            <p class="form-message form-message--error contact-form__error">
              {%- render 'icon', name: 'alert', size: 16 -%}
              <span>{{ 'errors.required' | t }}</span>
            </p>
          </div>

          <div class="field">
            <label class="field__label" for="{{ form_id }}-fault">{{ 'contact.repair.fault' | t }} {{ required_mark }}</label>
            <div class="select">
              <select id="{{ form_id }}-fault" name="contact[{{ 'contact.repair.fault' | t | escape }}]" required>
                <option value="">{{ 'contact.form.choose' | t }}</option>
                {%- assign fault_options = 'contact.repair.fault_options' | t | split: '|' -%}
                {%- for fault_option in fault_options -%}
                  <option value="{{ fault_option | strip | escape }}">{{ fault_option | strip | escape }}</option>
                {%- endfor -%}
              </select>
            </div>
            <p class="form-message form-message--error contact-form__error">
              {%- render 'icon', name: 'alert', size: 16 -%}
              <span>{{ 'errors.required' | t }}</span>
            </p>
          </div>

          {%- if branch_order.size > 0 -%}
            <div class="field">
              <label class="field__label" for="{{ form_id }}-branch">{{ 'contact.repair.branch' | t }}</label>
              <div class="select">
                <select id="{{ form_id }}-branch" name="contact[{{ 'contact.repair.branch' | t | escape }}]">
                  <option value="{{ 'contact.repair.branch_any' | t | escape }}">{{ 'contact.repair.branch_any' | t }}</option>
                  {%- for branch_position in branch_order -%}
                    {%- assign branch_index = branch_position | plus: 0 -%}
                    {%- for entry in metaobjects.branch.values -%}
                      {%- if forloop.index0 == branch_index and entry.name.value != blank -%}
                        <option value="{{ entry.name.value | strip | escape }}">{{ entry.name.value | strip | escape }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endfor -%}
                </select>
              </div>
            </div>
          {%- endif -%}
        {%- elsif form_kind == 'trade_in' -%}
          <input type="hidden" name="contact[subject]" value="{{ form_subject | escape }}">

          <div class="field">
            <label class="field__label" for="{{ form_id }}-device">{{ 'contact.trade_in.device' | t }} {{ required_mark }}</label>
            <input
              class="input"
              type="text"
              id="{{ form_id }}-device"
              name="contact[{{ 'contact.trade_in.device' | t | escape }}]"
              placeholder="{{ 'contact.repair.device_placeholder' | t }}"
              autocomplete="off"
              required
            >
            <p class="form-message form-message--error contact-form__error">
              {%- render 'icon', name: 'alert', size: 16 -%}
              <span>{{ 'errors.required' | t }}</span>
            </p>
          </div>

          <div class="field">
            <label class="field__label" for="{{ form_id }}-condition">{{ 'contact.trade_in.condition' | t }} {{ required_mark }}</label>
            <div class="select">
              <select id="{{ form_id }}-condition" name="contact[{{ 'contact.trade_in.condition' | t | escape }}]" required>
                <option value="">{{ 'contact.form.choose' | t }}</option>
                {%- assign condition_options = 'contact.trade_in.condition_options' | t | split: '|' -%}
                {%- for condition_option in condition_options -%}
                  <option value="{{ condition_option | strip | escape }}">{{ condition_option | strip | escape }}</option>
                {%- endfor -%}
              </select>
            </div>
            <p class="form-message form-message--error contact-form__error">
              {%- render 'icon', name: 'alert', size: 16 -%}
              <span>{{ 'errors.required' | t }}</span>
            </p>
          </div>

          <div class="field">
            <label class="field__label" for="{{ form_id }}-storage">{{ 'contact.trade_in.storage' | t }}</label>
            <div class="select">
              <select id="{{ form_id }}-storage" name="contact[{{ 'contact.trade_in.storage' | t | escape }}]">
                {%- assign storage_options = 'contact.trade_in.storage_options' | t | split: '|' -%}
                {%- for storage_option in storage_options -%}
                  <option value="{{ storage_option | strip | escape }}">{{ storage_option | strip | escape }}</option>
                {%- endfor -%}
              </select>
            </div>
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="{{ form_id }}-body">
            {{- body_label -}}
            {%- if body_required %} {{ required_mark }}{% endif -%}
          </label>
          <textarea
            class="textarea"
            id="{{ form_id }}-body"
            name="contact[body]"
            rows="5"
            {% if body_required %}required{% endif %}
            {% if body_invalid %}aria-invalid="true"{% endif %}
          >{{ form.body | escape }}</textarea>
          <p class="form-message form-message--error contact-form__error">
            {%- render 'icon', name: 'alert', size: 16 -%}
            <span>{{ 'errors.required' | t }}</span>
          </p>
        </div>

        {%- if section.settings.show_marketing -%}
          <div class="checkbox contact-form__check">
            <input
              type="checkbox"
              id="{{ form_id }}-marketing"
              name="contact[{{ 'contact.form.marketing_field' | t }}]"
              value="{{ 'contact.form.marketing_value' | t }}"
            >
            <label for="{{ form_id }}-marketing">{{ 'contact.form.marketing' | t }}</label>
          </div>
        {%- endif -%}

        {%- assign privacy_url = pages['privacy'].url | default: shop.privacy_policy.url -%}
        {%- if section.settings.show_privacy and privacy_url != blank -%}
          <div class="contact-form__consent">
            <div class="checkbox contact-form__check">
              <input
                type="checkbox"
                id="{{ form_id }}-privacy"
                name="contact[{{ 'contact.form.privacy_field' | t }}]"
                value="{{ 'contact.form.privacy_value' | t }}"
                required
              >
              <label for="{{ form_id }}-privacy">
                {{- 'contact.form.privacy_prefix' | t -}}
                <a href="{{ privacy_url }}" target="_blank" rel="noopener">
                  {{- 'contact.form.privacy_link' | t -}}
                  <span class="visually-hidden"> ({{ new_window }})</span>
                </a>
                {{ required_mark }}
              </label>
            </div>
            <p class="form-message form-message--error contact-form__error">
              {%- render 'icon', name: 'alert', size: 16 -%}
              <span>{{ 'errors.required' | t }}</span>
            </p>
          </div>
        {%- endif -%}

        <button type="submit" class="button button--accent button--large contact-form__submit">
          {{- submit_label | escape -}}
        </button>

        {%- if form_whatsapp_url != blank -%}
          {%- # Same size and place as the submit button (contact-form__submit sizing). -%}
          <a
            class="button button--outline button--large contact-form__submit contact-form__whatsapp"
            href="{{ form_whatsapp_url }}"
            target="_blank"
            rel="noopener"
          >
            {%- render 'icon', name: 'whatsapp', size: 20 -%}
            <span>{{ 'contact.form.whatsapp_button' | t }}</span>
            <span class="visually-hidden">({{ new_window }})</span>
          </a>
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- if section.settings.show_info -%}
      <div class="contact__info-col">
        {%- if section.settings.info_heading != blank -%}
          <h2 class="contact__info-heading">{{ section.settings.info_heading | escape }}</h2>
        {%- endif -%}

        <ul class="contact-info" role="list">
          {%- if phone_href != blank -%}
            <li class="contact-info__item">
              {%- render 'icon', name: 'phone', size: 22, class: 'contact-info__icon' -%}
              <div>
                <p class="contact-info__label">{{ 'contact.info.phone' | t }}</p>
                <a class="contact-info__value" href="{{ phone_href }}" dir="ltr">{{ phone_display | escape }}</a>
              </div>
            </li>
          {%- endif -%}
          {%- if whatsapp_url != blank -%}
            <li class="contact-info__item">
              {%- render 'icon', name: 'whatsapp', size: 22, class: 'contact-info__icon' -%}
              <div>
                <p class="contact-info__label">{{ 'contact.info.whatsapp' | t }}</p>
                <a
                  class="contact-info__value"
                  href="{{ whatsapp_url }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="{{ 'contact.info.whatsapp_link' | t: number: whatsapp_display }} ({{ new_window }})"
                ><bdi dir="ltr">{{ whatsapp_display | escape }}</bdi></a>
              </div>
            </li>
          {%- endif -%}
          {%- if settings.contact_email != blank -%}
            <li class="contact-info__item">
              {%- render 'icon', name: 'mail', size: 22, class: 'contact-info__icon' -%}
              <div>
                <p class="contact-info__label">{{ 'contact.info.email' | t }}</p>
                <a class="contact-info__value" href="mailto:{{ settings.contact_email | strip }}" dir="ltr">{{ settings.contact_email | strip | escape }}</a>
              </div>
            </li>
          {%- endif -%}
          {%- if address != blank -%}
            <li class="contact-info__item">
              {%- render 'icon', name: 'location', size: 22, class: 'contact-info__icon' -%}
              <div>
                <p class="contact-info__label">{{ 'contact.info.address' | t }}</p>
                <a
                  class="contact-info__value"
                  href="https://www.google.com/maps/search/?api=1&amp;query={{ address | url_encode | replace: '+', '%20' }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="{{ address | escape }} — {{ 'contact.info.map' | t }} ({{ new_window }})"
                >{{ address | escape }}</a>
              </div>
            </li>
          {%- endif -%}
          {%- if settings.store_hours != blank -%}
            <li class="contact-info__item">
              {%- render 'icon', name: 'clock', size: 22, class: 'contact-info__icon' -%}
              <div>
                <p class="contact-info__label">{{ 'contact.info.hours' | t }}</p>
                <p class="contact-info__text">{{ settings.store_hours | escape | newline_to_br }}</p>
              </div>
            </li>
          {%- endif -%}
        </ul>

        {%- if section.settings.info_text != blank -%}
          <div class="contact__info-text rte">{{ section.settings.info_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "טופס יצירת קשר",
  "class": "section-contact-form",
  "disabled_on": {
    "groups": ["header", "footer", "aside"]
  },
  "settings": [
    {
      "type": "select",
      "id": "form_kind",
      "label": "סוג הטופס",
      "info": "פנייה: שם, טלפון, אימייל והודעה. תיקון: דגם, סוג התקלה, סניף מועדף ותיאור. טרייד-אין: דגם, מצב המכשיר ונפח אחסון. בתיקון ובטרייד-אין נוסף למייל נושא קבוע.",
      "default": "contact",
      "options": [
        { "value": "contact", "label": "פנייה כללית" },
        { "value": "repair", "label": "תיקון (JOY FIX)" },
        { "value": "trade_in", "label": "טרייד-אין" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "שירות לקוחות"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "טקסט פתיחה",
      "default": "<p>כתבו לנו ונחזור אליכם בהקדם. לשאלות על שריון מוצר לאיסוף באילת, ציינו את שם המוצר בהודעה.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "שדה טלפון",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "phone_required",
      "label": "טלפון הוא שדה חובה",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_privacy",
      "label": "אישור מדיניות הפרטיות (חובה)",
      "info": "מוצג כשקיימת מדיניות פרטיות בהגדרות החנות › מדיניות.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_marketing",
      "label": "תיבת 'אשמח לקבל עדכונים'",
      "info": "לא מסומנת מראש. התשובה נוספת למייל הפנייה בלבד — טופס יצירת קשר לא רושם לדיוור.",
      "default": false
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "טקסט הכפתור",
      "default": "שליחת הפנייה"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "כפתור 'שליחה בוואטסאפ'",
      "info": "מתחת לכפתור השליחה, עם הודעה מוכנה לפי סוג הטופס.",
      "default": false
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "מספר וואטסאפ לכפתור",
      "info": "כשריק: מספר הוואטסאפ מהגדרות התבנית › יצירת קשר ורשתות חברתיות."
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "הודעה מוכנה בוואטסאפ",
      "info": "כשריק: הודעה לפי סוג הטופס (בפנייה כללית — ההודעה מהגדרות התבנית)."
    },
    {
      "type": "header",
      "content": "פרטי התקשרות"
    },
    {
      "type": "checkbox",
      "id": "show_info",
      "label": "הצגת פרטי התקשרות",
      "info": "טלפון, וואטסאפ, אימייל, כתובת ושעות פתיחה נלקחים מהגדרות התבנית › יצירת קשר ורשתות חברתיות.",
      "default": true
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "כותרת",
      "default": "פרטי התקשרות"
    },
    {
      "type": "richtext",
      "id": "info_text",
      "label": "טקסט נוסף"
    }
  ],
  "presets": [
    {
      "name": "טופס יצירת קשר"
    }
  ]
}
{% endschema %}
