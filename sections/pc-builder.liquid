{%- comment -%}
  "מרכיב מחשבים": the PC builder page (templates/page.pc-builder.json). The shell, the guided form and the summary are
  rendered here; assets/pc-builder.js fills them with the parts of the section's collection (every product of it,
  read client-side from /collections/<handle>/products.json, 250 a page; the pages the collection's count calls for,
  up to 4, are preloaded here and fetched at once) and assets/pc-builder-parser.js reads what
  each part is and what it fits from its title (the supplier's drop-ship parts come with no type or vendor).
  - Overrides: a product metafield in the "pc" namespace wins over the title (category, socket, memory, form_factor,
    watts, cooler_tdp, igpu, needs_cooler, back_connect; for quantities ram_slots, max_memory, m2_slots, sata_ports,
    pcie_x16, cpu_sockets, pcie_8pin, pcie_16pin; see the parser's header). They are printed below as JSON, only for
    products that have one (the first 250 products of the collection).
  - Search and quantities: each step filters its list as the customer types; memory kits, two graphics cards, two
    processors (dual-socket boards only), several drives and fan packs go to the cart with their quantity.
  - Cart: one /cart/add.js call with every part and its quantity, each with the properties _build_id (the same for
    the whole computer) and "הרכבה: כן", then the cart page.
  - Strict compatibility: a part that does not fit the parts of the steps before it cannot be chosen; choosing a part
    removes the later ones it no longer fits (with a notice and an undo); the cart and the quote need a complete build.
  - FPS: assets/pc-builder-fps.js (data-fps-src), an editable table of estimates, always shown as "הערכה בלבד".
  - Quote: a printable dialog (moved under <body> so the print stylesheet can print it alone); compare: up to 3
    builds saved in localStorage ("pcb-compare-v1").
  - Payments: "או 4 תשלומים של ₪X ללא ריבית" (X = total / 4 rounded up) on each guided build, under the summary total,
    in the phone bar and in the quote, with "אפשר גם עד 12 תשלומים (בריבית)" (no monthly sum); both numbers are settings.
  - WhatsApp: the section's number, else the theme setting "מספר וואטסאפ" (snippets/whatsapp-url).
  - Look (v3, 20.11.2026): a navy hero with a computer from the catalog and three chips; use cards with pictures and
    the cheapest build each starts at; the games as logo cards (assets/pcb-game-*, public-domain text logos, with a
    fine-print line); screen as a segmented control; the budget in a bubble over the slider; the builds as photo
    cards (a sideways strip on phones); the parts as cards with their photos; the phone bar with the chosen parts'
    photos, or a prompt while nothing is chosen. The chat bubble and the accessibility button dock into the bar's
    two ends on phones, so nothing floats over the form.
  - Pictures are settings (an uploaded image, else a product's featured image; defaults in the page template), and
    every word on the page comes from the locale (pc_builder.*); the strings the script draws with are in the
    data-pcb-i18n JSON below.
  - The harness that checks the parser and previews the page without a store is in .github/pc-builder.
{%- endcomment -%}
{%- render 'section-style', section: section -%}
{{ 'pc-builder.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'pc-builder.js' | asset_url }}"></script>
{%- liquid
  assign coll = section.settings.collection
  assign root = routes.root_url
  if root != '/'
    assign root = root | append: '/'
  endif
  if coll != blank
    assign source = root | append: 'collections/' | append: coll.handle | append: '/products.json?limit=250&page={page}'
    assign source_pages = coll.products_count | plus: 249 | divided_by: 250 | at_least: 1 | at_most: 4
    assign facts_source = root | append: 'collections/' | append: coll.handle | append: '?section_id=pc-builder-facts&page={page}'
  endif
  capture wa_url
    render 'whatsapp-url', phone: section.settings.whatsapp_number
  endcapture
  capture wa_display
    render 'whatsapp-url', phone: section.settings.whatsapp_number, format: 'display'
  endcapture
  assign wa_digits = wa_url | strip | remove: 'https://wa.me/'
  assign wa_display = wa_display | strip
  assign uid = 'pcb-' | append: section.id
  assign budget_min = section.settings.budget_min | default: 3500
  assign budget_max = section.settings.budget_max | default: 20000
  assign budget_default = section.settings.budget_default | default: 6000
  if budget_default < budget_min or budget_default > budget_max
    assign budget_default = budget_min | plus: budget_max | divided_by: 2
  endif
  # The budget bubble's place on the slider (0 to 1), so it is drawn where the script will keep it.
  assign budget_span = budget_max | minus: budget_min | at_least: 1
  assign budget_p = budget_default | minus: budget_min | times: 1.0 | divided_by: budget_span | round: 3

  # Copy: the section's own text when the owner typed one, else the locale (the store's own wording).
  if section.settings.heading != blank
    assign pcb_heading = section.settings.heading
  else
    assign pcb_heading = 'pc_builder.hero.heading' | t
  endif
  if section.settings.intro != blank
    assign pcb_sub = section.settings.intro
  else
    assign pcb_sub = 'pc_builder.hero.subtext' | t
  endif

  # Pictures: the uploaded one, else the chosen product's featured image (defaults in templates/page.pc-builder.json).
  assign hero_image = section.settings.hero_image | default: section.settings.hero_product.featured_image
  assign hero_alt = section.settings.hero_product.title | default: pcb_heading
  assign pcb_uses = 'gaming,work,office' | split: ','
-%}
{%- comment -%}
  The two modules pc-builder.js imports and the parts lists start downloading while the page is still parsing, instead
  of one after the other once the script runs (on a slow phone connection the first builds show ~2.5 s sooner).
  pc-builder.js fetches the very same URLs, with no extra header, so the browser reuses these responses.
  AssetPreload is off for these lines: preload_tag cannot make a modulepreload, and the lists are not theme assets.
{%- endcomment -%}
{% # theme-check-disable AssetPreload %}
<link rel="modulepreload" href="{{ 'pc-builder-parser.js' | asset_url }}">
<link rel="modulepreload" href="{{ 'pc-builder-fps.js' | asset_url }}">
{%- if source != blank -%}
  {%- assign pcb_page_token = '{' | append: 'page' | append: '}' -%}
  {%- for page in (1..source_pages) %}
    <link rel="preload" as="fetch" crossorigin href="{{ source | replace: pcb_page_token, page | escape }}">
  {%- endfor -%}
{%- endif %}
{% # theme-check-enable AssetPreload %}

<div
  class="pcb page-width"
  id="{{ uid }}"
  data-pc-builder
  data-parser-src="{{ 'pc-builder-parser.js' | asset_url }}"
  data-fps-src="{{ 'pc-builder-fps.js' | asset_url }}"
  {% if source != blank %}data-source="{{ source }}" data-pages="{{ source_pages }}" data-facts="{{ facts_source }}"{% endif %}
  data-whatsapp="{{ wa_digits | escape }}"
  data-whatsapp-display="{{ wa_display | escape }}"
  data-shop-name="{{ shop.name | escape }}"
  data-vat="{{ section.settings.vat_percent }}"
  data-service="{{ section.settings.service_text | escape }}"
  data-delivery="{{ section.settings.delivery_text | escape }}"
  data-budget-default="{{ budget_default }}"
  data-include-os="{{ section.settings.include_os }}"
  data-installments-free="{{ section.settings.installments_free }}"
  data-installments-max="{{ section.settings.installments_max }}"
  data-default-mode="{{ section.settings.default_mode }}"
>
  <header class="pcb-hero">
    <div class="pcb-hero__text">
      <h1 class="pcb-hero__title">{{ pcb_heading | escape_once }}</h1>
      <p class="pcb-hero__sub">{{ pcb_sub | escape_once }}</p>
      <ul class="pcb-hero__chips" role="list">
        <li class="pcb-hero__chip">{%- render 'pc-builder-icon', name: 'wrench', size: 16 -%}<span>{{ 'pc_builder.hero.chip_assembly' | t }}</span></li>
        <li class="pcb-hero__chip">
          {%- if section.settings.vat_percent > 0 -%}
            {%- render 'pc-builder-icon', name: 'truck', size: 16 -%}
          {%- else -%}
            {%- render 'pc-builder-icon', name: 'store', size: 16 -%}
          {%- endif -%}
          <span>{{ 'pc_builder.hero.chip_fulfilment' | t }}</span>
        </li>
        <li class="pcb-hero__chip">{%- render 'pc-builder-icon', name: 'shield', size: 16 -%}<span>{{ 'pc_builder.hero.chip_compatible' | t }}</span></li>
      </ul>
    </div>
    <div class="pcb-hero__media">
      {%- if hero_image != blank -%}
        {{
          hero_image
          | image_url: width: 720
          | image_tag:
            widths: '200, 280, 360, 480, 720',
            sizes: '(min-width: 992px) 360px, (min-width: 640px) 280px, 38vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'pcb-hero__img',
            alt: hero_alt
        }}
      {%- else -%}
        {%- render 'pc-builder-icon', name: 'tower', size: 96, class: 'pcb-hero__fallback' -%}
      {%- endif -%}
    </div>
  </header>

  {%- if coll == blank -%}
    <p class="pcb-empty">
      {%- if request.design_mode -%}
        {{ 'pc_builder.empty.editor' | t }}
      {%- else -%}
        {{ 'pc_builder.empty.soon' | t }}
      {%- endif -%}
    </p>
  {%- else -%}
    <div class="pcb__tabs" role="tablist" aria-label="{{ 'pc_builder.modes.label' | t }}">
      <button type="button" role="tab" class="pcb__tab" id="{{ uid }}-tab-guided" aria-controls="{{ uid }}-guided" aria-selected="true" data-mode-tab="guided">{{ 'pc_builder.modes.guided' | t }}</button>
      <button type="button" role="tab" class="pcb__tab" id="{{ uid }}-tab-steps" aria-controls="{{ uid }}-steps" aria-selected="false" tabindex="-1" data-mode-tab="steps">{{ 'pc_builder.modes.steps' | t }}</button>
    </div>

    <div class="pcb__body">
      <div class="pcb__main">
        <p class="pcb__status" data-status role="status">{{ 'pc_builder.status.loading' | t }}</p>
        <div class="pcb-notice" data-notice role="status" hidden></div>

        <div class="pcb__panel" role="tabpanel" id="{{ uid }}-guided" aria-labelledby="{{ uid }}-tab-guided" data-panel="guided">
          <form class="pcb-guided" data-guided-form novalidate onsubmit="return false">
            <fieldset class="pcb-field pcb-field--uses">
              <legend class="pcb-field__label">{{ 'pc_builder.uses.legend' | t }}</legend>
              <div class="pcb-uses">
                {%- for use in pcb_uses -%}
                  {%- liquid
                    assign use_image_key = use | append: '_image'
                    assign use_product_key = use | append: '_product'
                    # An uploaded picture (a lifestyle photo, 16:10) fills its card; a product photo sits whole on white.
                    assign use_image = section.settings[use_image_key]
                    assign use_image_class = 'pcb-use__img pcb-use__img--photo'
                    if use_image == blank
                      assign use_image = section.settings[use_product_key].featured_image
                      assign use_image_class = 'pcb-use__img'
                    endif
                    case use
                      when 'gaming'
                        assign use_label = 'pc_builder.uses.gaming' | t
                        assign use_icon = 'gamepad'
                      when 'work'
                        assign use_label = 'pc_builder.uses.work' | t
                        assign use_icon = 'film'
                      else
                        assign use_label = 'pc_builder.uses.office' | t
                        assign use_icon = 'briefcase'
                    endcase
                  -%}
                  <label class="pcb-use">
                    <input type="radio" name="use" value="{{ use }}"{% if forloop.first %} checked{% endif %}>
                    <span class="pcb-use__card">
                      <span class="pcb-use__media">
                        {%- if use_image != blank -%}
                          {{
                            use_image
                            | image_url: width: 360
                            | image_tag:
                              widths: '120, 180, 240, 360',
                              sizes: '(min-width: 992px) 180px, 30vw',
                              loading: 'eager',
                              class: use_image_class,
                              alt: ''
                          }}
                        {%- else -%}
                          {%- render 'pc-builder-icon', name: use_icon, size: 40, class: 'pcb-use__fallback' -%}
                        {%- endif -%}
                      </span>
                      <span class="pcb-use__name">{{ use_label }}</span>
                      <span class="pcb-use__from" data-use-from="{{ use }}"></span>
                      <span class="pcb-use__check" aria-hidden="true">{%- render 'pc-builder-icon', name: 'check', size: 14 -%}</span>
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
            <fieldset class="pcb-field pcb-field--games" data-games-field hidden>
              <legend class="pcb-field__label">{{ 'pc_builder.games.legend' | t }} <span class="pcb-field__opt">{{ 'pc_builder.games.optional' | t }}</span></legend>
              <div class="pcb-games" data-games></div>
              <p class="pcb-games__fine">{{ 'pc_builder.games.fineprint' | t }}</p>
            </fieldset>
            <fieldset class="pcb-field" data-res-field hidden>
              <legend class="pcb-field__label">{{ 'pc_builder.screen.legend' | t }}</legend>
              <div class="pcb-seg">
                <label class="pcb-seg__opt"><input type="radio" name="res" value="1080p" checked><span><b>1080p</b><small>{{ 'pc_builder.screen.fhd' | t }}</small></span></label>
                <label class="pcb-seg__opt"><input type="radio" name="res" value="1440p"><span><b>1440p</b><small>{{ 'pc_builder.screen.qhd' | t }}</small></span></label>
                <label class="pcb-seg__opt"><input type="radio" name="res" value="4k"><span><b>4K</b><small>{{ 'pc_builder.screen.uhd' | t }}</small></span></label>
              </div>
            </fieldset>
            <div class="pcb-field pcb-field--budget">
              <span class="pcb-field__label" id="{{ uid }}-budget-l">{{ 'pc_builder.budget.label' | t }}</span>
              <div class="pcb-range-wrap" style="--p: {{ budget_p }}">
                <output class="pcb-budget" for="{{ uid }}-budget" data-budget-out>₪{{ budget_default }}</output>
                <input class="pcb-range" type="range" id="{{ uid }}-budget" aria-labelledby="{{ uid }}-budget-l" name="budget" min="{{ budget_min }}" max="{{ budget_max }}" step="100" value="{{ budget_default }}" style="--fill: {{ budget_p | times: 100 }}%">
              </div>
              <div class="pcb-range__scale" aria-hidden="true"><span>₪{{ budget_min }}</span><span>₪{{ budget_max }}</span></div>
            </div>
            <label class="pcb-check">
              <input type="checkbox" name="include_os"{% if section.settings.include_os %} checked{% endif %}>
              <span class="pcb-check__text">{{ 'pc_builder.os.label' | t }}</span>
            </label>
          </form>
          <h2 class="pcb-builds__title">{{ 'pc_builder.builds.heading' | t }}</h2>
          <div class="pcb-builds" data-builds aria-live="polite"></div>
        </div>

        <div class="pcb__panel" role="tabpanel" id="{{ uid }}-steps" aria-labelledby="{{ uid }}-tab-steps" data-panel="steps" hidden>
          <nav class="pcb-progress" data-stepnav aria-label="{{ 'pc_builder.steps.nav' | t }}"></nav>
          <div data-step-body></div>
        </div>
      </div>

      <aside class="pcb-sum" aria-labelledby="{{ uid }}-sum-h">
        <div class="pcb-sum__bar">
          <button type="button" class="pcb-sum__toggle" data-action="toggle-summary" aria-expanded="false" aria-controls="{{ uid }}-sum-panel">
            <span class="pcb-sum__thumbs" data-thumbs aria-hidden="true"></span>
            <span class="pcb-sum__figures">
              <span class="pcb-sum__toggle-total"><span class="visually-hidden">{{ 'pc_builder.summary.total' | t }} </span><span data-total>₪0</span></span>
              <span class="pcb-sum__state" data-summary-chip></span>
              <span class="pcb-sum__toggle-pay" data-pay-bar hidden></span>
            </span>
            <span class="pcb-sum__prompt">
              {%- render 'pc-builder-icon', name: 'tower', size: 22 -%}
              <span>{{ 'pc_builder.summary.empty_bar' | t }}</span>
            </span>
            <svg class="pcb-sum__chev" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 15 6-6 6 6"/></svg>
            <span class="visually-hidden">{{ 'pc_builder.summary.details' | t }}</span>
          </button>
          <button type="button" class="button pcb-sum__bar-cart" data-action="add-to-cart" disabled>{{ 'pc_builder.summary.add_short' | t }}</button>
        </div>
        <div class="pcb-sum__panel" id="{{ uid }}-sum-panel" data-summary-panel tabindex="-1">
          <div class="pcb-sum__head">
            <h2 class="pcb-sum__title" id="{{ uid }}-sum-h">{{ 'pc_builder.summary.title' | t }}</h2>
            <span class="pcb-sum__count" data-count></span>
          </div>
          <div data-summary-body></div>
          <p class="pcb-sum__total"><span>{{ 'pc_builder.summary.total' | t }}</span> <strong data-total>₪0</strong></p>
          <p class="pcb-pay pcb-sum__pay" data-pay hidden></p>
          <p class="pcb-sum__vat">{% if section.settings.vat_percent > 0 %}{{ 'pc_builder.summary.vat_included' | t }}{% else %}{{ 'pc_builder.summary.vat_eilat' | t }}{% endif %}{% if section.settings.service_text != blank %} · {{ section.settings.service_text | escape }}{% endif %}</p>
          <div class="pcb-sum__actions">
            <button type="button" class="button button--full button--large" data-action="add-to-cart" disabled>{{ 'pc_builder.summary.add' | t }}</button>
            <p class="pcb-sum__note" data-cart-note hidden></p>
            <p class="form-message form-message--error" data-cart-error role="alert" hidden></p>
            <div class="pcb-sum__secondary">
              {%- if wa_digits != blank -%}
                <button type="button" class="button button--outline pcb-sum__wa" data-action="whatsapp" disabled>
                  <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.2-.3-.2-.5-.3Z"/></svg>
                  {{ 'pc_builder.summary.whatsapp' | t }}
                </button>
              {%- endif -%}
              <div class="pcb-more">
                <button type="button" class="button button--outline pcb-more__toggle" data-action="toggle-more" aria-expanded="false" aria-controls="{{ uid }}-more">
                  {{ 'pc_builder.summary.more' | t }}
                  <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <ul class="pcb-more__list" id="{{ uid }}-more" role="list" hidden>
                  <li><button type="button" class="pcb-more__item" data-action="quote" disabled>{{ 'pc_builder.summary.quote' | t }}</button></li>
                  <li><button type="button" class="pcb-more__item" data-action="save" disabled>{{ 'pc_builder.summary.save' | t }}</button></li>
                  <li><button type="button" class="pcb-more__item" data-action="compare" disabled>{{ 'pc_builder.summary.compare' | t }} <span data-saved-count></span></button></li>
                  <li><button type="button" class="pcb-more__item" data-action="share" disabled><span data-share-label>{{ 'pc_builder.summary.share' | t }}</span></button></li>
                  <li><button type="button" class="pcb-more__item" data-action="clear">{{ 'pc_builder.summary.clear' | t }}</button></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <dialog class="pcb-dialog pcb-quote" data-quote-dialog aria-labelledby="{{ uid }}-quote-h">
      <div class="pcb-quote__doc" data-quote-body></div>
      <div class="pcb-dialog__actions" data-no-print>
        <button type="button" class="button" data-quote-print>{{ 'pc_builder.quote.print' | t }}</button>
        <button type="button" class="button button--outline" data-quote-close>{{ 'pc_builder.dialog.close' | t }}</button>
      </div>
    </dialog>

    <dialog class="pcb-dialog pcb-compare" data-compare-dialog aria-labelledby="{{ uid }}-compare-h">
      <div class="pcb-dialog__head">
        <h2 class="pcb-dialog__title" id="{{ uid }}-compare-h">{{ 'pc_builder.summary.compare' | t }}</h2>
        <button type="button" class="pcb-dialog__close" data-action="close-compare" aria-label="{{ 'pc_builder.dialog.close' | t }}">
          <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <div data-compare-body></div>
    </dialog>

    <p class="visually-hidden" data-live aria-live="polite"></p>
    <noscript><p class="pcb-empty">{{ 'pc_builder.empty.no_js' | t }}</p></noscript>
    {%- comment -%}
      The strings and pictures the script draws with (the use cards' "from" line, the games' cards, the summary bar),
      from the locale and the theme's assets.
    {%- endcomment -%}
    <script type="application/json" data-pcb-i18n>
      {
        "from": {{ 'pc_builder.uses.from' | t: price: '__price__' | json }},
        "gameTarget": {{ 'pc_builder.games.target' | t: fps: '__fps__' | json }},
        "selected": {{ 'pc_builder.builds.selected' | t | json }},
        "choose": {{ 'pc_builder.builds.choose' | t | json }},
        "edit": {{ 'pc_builder.builds.edit' | t | json }},
        "ready": {{ 'pc_builder.summary.ready' | t | json }},
        "logos": {
          "fortnite": {{ 'pcb-game-fortnite.svg' | asset_url | json }},
          "valorant": {{ 'pcb-game-valorant.svg' | asset_url | json }},
          "cs2": {{ 'pcb-game-cs2.svg' | asset_url | json }},
          "warzone": {{ 'pcb-game-warzone.svg' | asset_url | json }},
          "cyberpunk": {{ 'pcb-game-cyberpunk.webp' | asset_url | json }},
          "fc": {{ 'pcb-game-fc.svg' | asset_url | json }}
        }
      }
    </script>
    {%- comment -%}
      The parts' facts of the collection's first 250 products (snippets/pc-builder-facts: pcb.<key>, else pc.<key>); the
      pages after it come from sections/pc-builder-facts (data-facts).
    {%- endcomment -%}
    <script type="application/json" data-pcb-overrides>
      {
      {%- assign first = true -%}
      {%- paginate coll.products by 250 -%}
        {%- for product in coll.products -%}
          {%- capture pcb_row -%}{%- render 'pc-builder-facts', product: product -%}{%- endcapture -%}
          {%- if pcb_row != blank -%}
            {%- unless first %},{% endunless -%}
            {%- assign first = false -%}
            {{ pcb_row }}
          {%- endif -%}
        {%- endfor -%}
      {%- endpaginate -%}
      }
    </script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "מרכיב מחשבים",
  "class": "section-pc-builder",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "קולקציית הרכיבים",
