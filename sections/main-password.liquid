{%- comment -%}
  Password (coming soon) page. Logo: the theme logo, else the JOY Mobile lockup for light
  backgrounds from the owner's brand sheet (assets/logo-joy-light.png, 871×249: navy JOY on a
  white block + navy MOBILE block). The shop-level Brand logo is deliberately not a fallback.
{%- endcomment -%}
{%- liquid
  assign brand_name = settings.brand_name | strip | default: shop.name
  assign pw_logo = settings.logo
-%}
<div class="password page-width page-width--narrow">
  {%- if section.settings.show_logo -%}
    <div class="password__brand">
      {%- if pw_logo != blank -%}
        {% render 'image', image: pw_logo, widths: '260,520,780', sizes: 'min(260px, 70vw)', loading: 'eager', alt: brand_name, class: 'password__logo' %}
      {%- else -%}
        {%- assign pw_logo_url = 'logo-joy-light.png' | asset_url -%}
        <img
          class="password__logo"
          src="{{ pw_logo_url }}&amp;width=520"
          srcset="{{ pw_logo_url }}&amp;width=260 260w, {{ pw_logo_url }}&amp;width=520 520w, {{ pw_logo_url }}&amp;width=780 780w, {{ pw_logo_url }} 871w"
          sizes="min(260px, 70vw)"
          width="871"
          height="249"
          alt="{{ brand_name | escape }}"
        >
      {%- endif -%}
    </div>
  {%- endif -%}

  <h1 class="password__title">{{ section.settings.heading | escape }}</h1>

  {%- if section.settings.message != blank -%}
    <div class="password__message rte">{{ section.settings.message }}</div>
  {%- endif -%}

  {%- if shop.password_message != blank -%}
    <p class="password__store-message">{{ shop.password_message | escape }}</p>
  {%- endif -%}

  {%- if section.settings.show_newsletter -%}
    {%- form 'customer', id: 'PasswordNewsletter', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, password-page">
      <h2 class="password__form-title">{{ 'general.password.newsletter_heading' | t }}</h2>
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">
          {%- render 'icon', name: 'check', size: 18 -%}
          {{ 'general.password.newsletter_success' | t }}
        </p>
      {%- else -%}
        <div class="password__row">
          <div class="field">
            <label class="field__label" for="PasswordNewsletter-email">{{ 'general.password.newsletter_label' | t }}</label>
            <input
              class="input"
              id="PasswordNewsletter-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              placeholder="{{ 'general.password.newsletter_placeholder' | t }}"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="PasswordNewsletter-error"{% endif %}
            >
          </div>
          <button class="button button--accent" type="submit">{{ 'general.password.newsletter_submit' | t }}</button>
        </div>
        {%- comment -%} Same explicit consent as the VIP signup: unchecked, required (anti-spam law). {%- endcomment -%}
        <div class="checkbox password__consent">
          <input
            id="PasswordNewsletter-consent"
            type="checkbox"
            name="contact[marketing_consent]"
            value="express-email-opt-in"
            required
          >
          <label for="PasswordNewsletter-consent">
            <span class="password__required" aria-hidden="true">*</span>
            {{ section.settings.consent_text }}
          </label>
        </div>
        {%- if form.errors -%}
          <div class="form-message form-message--error" id="PasswordNewsletter-error">
            {%- render 'icon', name: 'alert', size: 18 -%}
            <div>{{ form.errors | default_errors }}</div>
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  {%- endif -%}

  {%- form 'storefront_password', id: 'StorefrontPassword', class: 'password__login' -%}
    <details class="password__details"{% if form.errors %} open{% endif %}>
      <summary class="password__summary">
        {%- render 'icon', name: 'lock', size: 18 -%}
        {{ 'general.password.password_toggle' | t }}
      </summary>
      <div class="password__login-body">
        <h2 class="password__form-title">{{ 'general.password.password_heading' | t }}</h2>
        <div class="password__row">
          <div class="field">
            <label class="field__label" for="StorefrontPassword-password">{{ 'general.password.password_label' | t }}</label>
            <input
              class="input"
              id="StorefrontPassword-password"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="StorefrontPassword-error" autofocus{% endif %}
            >
          </div>
          <button class="button" type="submit">{{ 'general.password.password_submit' | t }}</button>
        </div>
        {%- if form.errors -%}
          <div class="form-message form-message--error" id="StorefrontPassword-error">
            {%- render 'icon', name: 'alert', size: 18 -%}
            <div>{{ form.errors | default_errors }}</div>
          </div>
        {%- endif -%}
      </div>
    </details>
  {%- endform -%}

  <footer class="password__footer">
    <p>{{ 'general.password.admin_html' | t }}</p>
    <p>{{ powered_by_link }}</p>
  </footer>
</div>

{% stylesheet %}
  .password {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    min-height: 100vh;
    min-height: 100dvh;
    padding-block: var(--space-2xl);
    text-align: center;
  }
  .password__brand {
    width: min(16.25rem, 70vw);
  }
  .password__logo {
    width: 100%;
    height: auto;
  }
  .password__title {
    font-size: var(--text-4xl);
  }
  .password__message,
  .password__store-message {
    max-width: 36rem;
    color: var(--color-text);
  }
  .password__form,
  .password__login {
    width: 100%;
    max-width: 30rem;
    text-align: start;
  }
  .password__form {
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .password__form-title {
    margin-block-end: var(--space-sm);
    font-size: var(--text-xl);
  }
  .password__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-xs);
  }
  .password__row .field {
    flex: 1 1 14rem;
  }
  .password__form .form-message,
  .password__login .form-message {
    margin-block-start: var(--space-sm);
  }
  .password__consent {
    margin-block-start: var(--space-sm);
    line-height: var(--leading-normal);
  }
  .password__consent label {
    cursor: pointer;
  }
  .password__consent a {
    color: inherit;
    text-decoration: underline;
  }
  .password__required {
    color: var(--color-error);
    font-weight: 700;
  }
  .password__summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap-target);
    color: var(--color-ink);
    font-weight: 500;
    text-decoration: underline;
    cursor: pointer;
  }
  .password__summary {
    list-style: none;
  }
  .password__summary::-webkit-details-marker {
    display: none;
  }
  .password__login-body {
    padding-block-start: var(--space-sm);
  }
  .password__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-block-start: auto;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .password__footer a {
    color: var(--color-ink);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "עמוד סיסמה",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "הצגת הלוגו",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "החנות תיפתח בקרוב"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "הודעה",
      "default": "<p>אנחנו מסיימים להכין את האתר החדש של JOY Mobile באילת. השאירו אימייל ונעדכן אתכם כשנפתחים.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "טופס הרשמה לעדכונים",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "consent_text",
      "label": "טקסט ההסכמה לדיוור",
      "info": "תיבת הסימון לא מסומנת מראש והיא חובה (חוק הספאם). מומלץ לקשר למדיניות הפרטיות.",
      "default": "אני מסכים/ה לקבל מ-JOY Mobile דברי פרסומת, הטבות ועדכונים בדוא״ל. אפשר להסיר את ההרשמה בכל עת. קראתי את <a href=\"/pages/privacy\">מדיניות הפרטיות</a>."
    }
  ]
}
{% endschema %}
