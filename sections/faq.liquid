{%- comment -%}
  FAQ accordion. Native <details>/<summary>: keyboard and screen-reader accessible,
  works without JavaScript, find-in-page opens the matching answer (the answers are in
  the HTML even while closed, so search engines and AI assistants read them too).
  Optional "one open at a time" uses the <details name> grouping (browsers without it
  simply allow several open). templates/page.faqs.json holds the store's questions,
  answered only from the live site's pages (terms, cancellation, branches, lab) and the
  store's own texts. A contact call-to-action closes the list.

  Structured data (setting "נתונים מובנים"): a FAQPage from the same blocks, each answer
  as plain text (snippets/plain-text: tags removed, entities decoded); a question whose
  answer is empty is left out of it. One FAQPage per page, so one section per page with
  the setting on.
{%- endcomment -%}
{%- render 'section-style', section: section -%}
{{ 'section-faq.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign question_count = 0
  for block in section.blocks
    if block.type == 'question' and block.settings.question != blank
      assign question_count = question_count | plus: 1
    endif
  endfor
-%}

<div class="faq page-width">
  <div class="faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="faq__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}

    {%- if question_count > 0 -%}
      <div class="faq__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' and block.settings.question != blank -%}
            <details
              class="faq-item"
              id="Faq-{{ block.id }}"
              {{ block.shopify_attributes }}
              {% if section.settings.one_open %}name="faq-{{ section.id }}"{% endif %}
              {% if section.settings.open_first and forloop.first %}open{% endif %}
            >
              <summary class="faq-item__question">
                <span class="faq-item__text">{{ block.settings.question | escape }}</span>
                {%- render 'icon', name: 'chevron-down', size: 20, class: 'faq-item__icon' -%}
              </summary>
              <div class="faq-item__answer rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_heading != blank or section.settings.cta_text != blank or section.settings.cta_label != blank -%}
      <div class="faq__cta">
        {%- if section.settings.cta_heading != blank -%}
          <p class="faq__cta-heading">{{ section.settings.cta_heading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <p class="faq__cta-text">{{ section.settings.cta_text }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <a class="button button--accent faq__cta-button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.structured_data and question_count > 0 -%}
  {%- assign faq_json_count = 0 -%}
  {%- capture faq_questions_json -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'question' and block.settings.question != blank -%}
        {%- capture faq_answer_text -%}{%- render 'plain-text', html: block.settings.answer -%}{%- endcapture -%}
        {%- if faq_answer_text != blank -%}
          {%- if faq_json_count > 0 -%},{%- endif -%}
          {%- assign faq_json_count = faq_json_count | plus: 1 -%}
          {"@type": "Question", "name": {{ block.settings.question | strip_html | strip | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ faq_answer_text | json }} } }
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if faq_json_count > 0 -%}
    <script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{{ faq_questions_json | strip_newlines | replace: '</', '<\/' }}]}</script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "שאלות נפוצות",
  "class": "section-faq",
  "disabled_on": {
    "groups": [
      "header",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "שאלות נפוצות"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "טקסט פתיחה"
    },
    {
      "type": "checkbox",
      "id": "one_open",
      "label": "תשובה אחת פתוחה בכל פעם",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "השאלה הראשונה פתוחה",
      "default": false
    },
    {
      "type": "header",
      "content": "פנייה בסוף הרשימה"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "כותרת",
      "default": "לא מצאתם את התשובה?"
    },
    {
      "type": "inline_richtext",
      "id": "cta_text",
      "label": "טקסט",
      "default": "אנחנו כאן כדי לעזור."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "טקסט הכפתור",
      "default": "צרו קשר"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "קישור"
    },
    {
      "type": "header",
      "content": "מנועי חיפוש"
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "נתונים מובנים (FAQPage)",
      "info": "כדאי להפעיל רק בסקשן שאלות אחד בכל עמוד.",
      "default": true
    },
    {
      "type": "header",
      "content": "עיצוב הסקשן"
    },
    {
      "type": "paragraph",
      "content": "כל מה שנשאר ריק לוקח את העיצוב הכללי של האתר (הגדרות התבנית › צבעים, טיפוגרפיה)."
    },
    {
      "type": "color_background",
      "id": "ss_background",
      "label": "רקע",
      "info": "צבע אחיד או מעבר צבעים (גרדיאנט)."
    },
    {
      "type": "color",
      "id": "ss_text_color",
      "label": "צבע טקסט"
    },
    {
      "type": "color",
      "id": "ss_heading_color",
      "label": "צבע כותרות"
    },
    {
      "type": "color",
      "id": "ss_accent_color",
      "label": "צבע הדגשה",
      "info": "קישורים, אייקונים ופרטים צבעוניים."
    },
    {
      "type": "color",
      "id": "ss_button_bg",
      "label": "צבע כפתורים"
    },
    {
      "type": "color",
      "id": "ss_button_text",
      "label": "צבע טקסט בכפתורים"
    },
    {
      "type": "range",
      "id": "ss_text_scale",
      "label": "גודל טקסט",
      "min": 80,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "ss_radius",
      "label": "פינות של כפתורים וכרטיסים",
      "options": [
        {
          "value": "theme",
          "label": "כמו בשאר האתר"
        },
        {
          "value": "square",
          "label": "ישרות"
        },
        {
          "value": "soft",
          "label": "מעוגלות מעט"
        },
        {
          "value": "round",
          "label": "מעוגלות"
        },
        {
          "value": "pill",
          "label": "עגולות לגמרי"
        }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "ss_custom_heading_font",
      "label": "פונט אחר לכותרות",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "ss_heading_font",
      "label": "פונט כותרות",
      "info": "לעברית: Assistant, Heebo, Rubik, Noto Sans Hebrew, Frank Ruhl Libre.",
      "default": "assistant_n7",
      "visible_if": "{{ section.settings.ss_custom_heading_font }}"
    },
    {
      "type": "checkbox",
      "id": "ss_custom_body_font",
      "label": "פונט אחר לטקסט",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "ss_body_font",
      "label": "פונט טקסט",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.ss_custom_body_font }}"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "שאלה",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "שאלה",
          "default": "שאלה"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "תשובה",
          "default": "<p>התשובה לשאלה.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "שאלות נפוצות",
      "settings": {
        "heading": "לפני שמזמינים"
      },
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "איזה מחיר מוצג באתר?",
            "answer": "<p>המחירים באתר הם מחירי אילת ללא מע״מ, לשריון באתר ולאיסוף עצמי מסניף באילת.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "מה זה שריון?",
            "answer": "<p>שריון הוא הזמנה מראש של מוצר באתר, לאיסוף עצמי מסניף באילת. פרטי האיסוף יופיעו במהלך ההזמנה ובאישור שלה.</p>"
          }
        },
