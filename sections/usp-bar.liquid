{%- comment -%}
  Benefits strip: short reasons to buy (an icon, a bold line and a short note per block, optionally a
  link), in a row of soft tiles under the hero. Phones: a two-column grid; the tiles wrap, nothing
  scrolls. The whole tile is the link when a block has one.
{%- endcomment -%}
{%- render 'section-style', section: section -%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    --usp-pad-top: {{ section.settings.padding_top }}px;
    --usp-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
  {%- comment -%} Only with the section's own heading font: otherwise the titles keep the body font they inherit. {%- endcomment -%}
  {%- if section.settings.ss_custom_heading_font and section.settings.ss_heading_font != blank %}
  #shopify-section-{{ section.id }} .usp-bar__title {
    font-family: var(--font-heading-family);
  }
  {%- endif %}
{%- endstyle -%}

{{ 'section-usp-bar.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div class="usp-bar">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="visually-hidden">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <ul class="usp-bar__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign usp_link = block.settings.link
            # Keep the existing service shortcut useful until its Shopify page is published.
            if usp_link == '/pages/joy-fix' and pages['joy-fix'].url == blank
              assign usp_link = pages['contact'].url
              if usp_link != blank
                assign usp_link = usp_link | append: '#branches'
              endif
            endif
          -%}
          <li class="usp-bar__item" {{ block.shopify_attributes }}>
            {%- capture usp_inner -%}
              <span class="usp-bar__icon">
                {%- render 'icon', name: block.settings.icon, size: 24 -%}
              </span>
              <span class="usp-bar__text">
                <span class="usp-bar__title">{{ block.settings.title | escape }}</span>
                {%- if block.settings.text != blank -%}
                  <span class="usp-bar__note">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </span>
            {%- endcapture -%}
            {%- if usp_link != blank -%}
              <a class="usp-bar__tile usp-bar__tile--link" href="{{ usp_link }}">{{ usp_inner }}</a>
            {%- else -%}
              <div class="usp-bar__tile">{{ usp_inner }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

