{%- comment -%}
  Cart drawer — <cart-drawer id="CartDrawer"> (@theme/cart, a DialogElement): opened by the
  header cart link ([aria-haspopup=dialog][aria-controls=CartDrawer]) and by every AJAX add;
  focus trap, Escape, overlay click, scroll lock and focus return come from global.js.
  Every cart mutation re-renders this section through bundled section rendering, so all
  markup and prices come from Liquid (cart.js swaps the element's children and class).
  Content: lines (snippets/cart-line) inside <cart-items>, the pickup-in-Eilat / payment
  message (theme setting), the reservation conditions (section setting), the optional
  required 90-day consent (theme setting, off by default; saved as a cart attribute on change), the order note, the total and the
  green "המשך לשריון" checkout button (a POST to /cart with `checkout`, so the note and the
  consent are saved on the way), plus app blocks. Also the pickup-branch choice after the pickup
  message (snippets/branch-picker, only when Shopify reports two or more branches holding every
  line) and, under the checkout area, the "לשריון דרך וואטסאפ" link (snippets/cart-whatsapp,
  section setting). Without JS the header cart link simply opens /cart.
{%- endcomment -%}
{%- render 'section-style', section: section -%}
{%- liquid
  assign drawer_count = cart.item_count
  assign pickup_message = settings.cart_pickup_message

  # As on the cart page (sections/main-cart): the VAT-free claim under the total only when every
  # line really is exempt.
  assign all_tax_free = true
  for item in cart.items
    if item.variant.taxable
      assign all_tax_free = false
      break
    endif
  endfor
-%}
{%- comment -%}
  Normal stylesheets, not deferred: this section sits at the end of the body, so they do not hold up the
  first paint or the hero, and a drawer opened on a slow connection must be visible at once (a deferred
  stylesheet left it open but invisible, with the page's scroll locked, until the CSS arrived).
{%- endcomment -%}
{{ 'component-drawer.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_upsell -%}
  {{ 'component-cart-upsell.css' | asset_url | stylesheet_tag }}
  <script type="module" src="{{ 'cart-upsell.js' | asset_url }}"></script>
{%- endif -%}

<cart-drawer id="CartDrawer" class="drawer cart-drawer{% if drawer_count == 0 %} is-empty{% endif %}" data-section-id="{{ section.id }}">
  <div class="drawer__overlay" data-close></div>
  <div class="drawer__panel cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawer-Title" tabindex="-1">
    <div class="drawer__header">
      <h2 class="drawer__title" id="CartDrawer-Title">
        {{- 'cart.drawer.title' | t -}}
        {%- if drawer_count > 0 %}
          <span class="cart-drawer__count">({{ 'cart.drawer.count' | t: count: drawer_count }})</span>
        {%- endif -%}
      </h2>
      <button class="drawer__close" type="button" data-close aria-label="{{ 'cart.drawer.close' | t }}">
        {%- render 'icon', name: 'close', size: 24 -%}
      </button>
    </div>

    {%- comment -%}
      Announcements made while the drawer is open ("העגלה עודכנה", stock errors) go here, not to the
      page-level region: VoiceOver can ignore everything outside an aria-modal dialog, live regions
      included. @theme/global's announce() prefers this one while the dialog traps focus, and cart.js
      keeps this very node across re-renders (a fresh region is not always listened to yet).
    {%- endcomment -%}
    <p class="visually-hidden" data-a11y-live role="status" aria-live="polite"></p>

    {%- comment -%}
      The undo bar is printed here, hidden, rather than created by the script: every cart change
      re-renders this section, so anything the script injected would be wiped a moment later. It sits
      outside <cart-items> because removing the last line replaces that element with the empty state,
      and that is exactly the removal a shopper is most likely to want back.
    {%- endcomment -%}
    <div class="cart-drawer__undo" data-cart-undo role="status" hidden>
      <p class="cart-drawer__undo-text">
        <strong data-cart-undo-title></strong>
        {{ 'cart.drawer.undo_removed' | t }}
      </p>
      <button class="button button--small cart-drawer__undo-button" type="button" data-cart-undo-button>
        {%- render 'icon', name: 'arrow-right', size: 14 -%}
        {{- 'cart.drawer.undo' | t -}}
      </button>
    </div>

    {%- if drawer_count > 0 -%}
      <cart-items class="drawer__body cart-drawer__body">
        <ul class="cart-drawer__lines" role="list" aria-label="{{ 'cart.drawer.lines_label' | t }}">
          {%- for item in cart.items -%}
            {%- render 'cart-line', item: item, index: forloop.index, context: 'drawer' -%}
          {%- endfor -%}
        </ul>

        {%- comment -%}
          Pickup only, pay at the branch or online: said right under the lines, before the accessory row
          that appears a moment later, so the one thing that differs from an ordinary shop is never
          pushed out of sight.
        {%- endcomment -%}
        {%- if pickup_message != blank -%}
          <div class="cart-drawer__notice">
            {%- render 'icon', name: 'store', size: 22 -%}
            <p><span class="visually-hidden">{{ 'cart.drawer.pickup_label' | t }}: </span>{{ pickup_message }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.show_upsell -%}
          {%- render 'cart-upsell', context: 'drawer' -%}
        {%- endif -%}

        {%- for block in section.blocks -%}
          <div class="cart-drawer__app" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endfor -%}

        <form class="cart-drawer__form" action="{{ routes.cart_url }}" method="post" id="CartDrawer-Form" accept-charset="UTF-8">
          {%- render 'branch-picker', context: 'drawer', class: 'cart-drawer__branch' -%}

          {%- if section.settings.conditions != blank -%}
            <div class="cart-drawer__conditions rte">{{ section.settings.conditions }}</div>
          {%- endif -%}

          {%- if settings.cart_note_enabled -%}
            <details class="cart-drawer__note"{% if cart.note != blank %} open{% endif %}>
              <summary class="cart-drawer__note-toggle">
                {{- 'cart.drawer.note_label' | t -}}
                {%- render 'icon', name: 'chevron-down', size: 16, class: 'cart-drawer__note-icon' -%}
              </summary>
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'cart.drawer.note_label' | t }}</label>
              <textarea class="textarea cart-drawer__note-field" id="CartDrawer-Note" name="note" rows="3">{{ cart.note | escape_once }}</textarea>
            </details>
          {%- endif -%}

          <div class="drawer__footer cart-drawer__footer">
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="cart-drawer__discounts" role="list" aria-label="{{ 'cart.drawer.discounts' | t }}">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li>
                    {%- render 'icon', name: 'tag', size: 14 -%}
                    <span>{{ discount.title | escape }} {% render 'money-signed', amount: discount.total_allocated_amount %}</span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <p class="cart-drawer__total">
              <span>{{ 'cart.drawer.subtotal' | t }}</span>
              <span class="cart-drawer__total-amount" data-cart-total>{{ cart.total_price | money_without_trailing_zeros }}</span>
            </p>

            {%- if all_tax_free and settings.tax_free_labels -%}
              <p class="cart-drawer__tax">
                <span>{{ 'cart.page.tax_free' | t }}</span>
                <span class="cart-drawer__chip" lang="en">{{ 'products.price.tax_free' | t }}</span>
              </p>
            {%- endif -%}

            {%- if settings.cart_vat_consent_enabled and settings.cart_vat_consent_text != blank -%}
              {%- liquid
                # Same cart attribute as the cart page (sections/main-cart). @theme/cart saves it on change, so
                # re-renders (quantity, remove) keep the tick.
                assign vat_consent_key = 'cart.page.vat_consent_attribute' | t
              -%}
              <label class="checkbox cart-drawer__consent">
                <input
                  type="checkbox"
                  name="attributes[{{ vat_consent_key }}]"
                  value="{{ 'cart.page.consent_value' | t }}"
                  required
                  {% if cart.attributes[vat_consent_key] != blank %}
                    checked
                  {% endif %}
                >
                <span>{{ settings.cart_vat_consent_text }}</span>
              </label>
            {%- endif -%}

            <button class="button button--accent button--full button--large cart-drawer__checkout" type="submit" name="checkout">
              {{- 'cart.drawer.checkout' | t -}}
            </button>
            <p class="cart-drawer__checkout-note">
              {%- render 'icon', name: 'lock', size: 14 -%}
              {{ 'cart.drawer.checkout_note' | t }}
            </p>

            {%- comment -%}
              The card marks sit under the checkout button, not at the bottom of the panel: they are
              there to answer "can I pay with my card" at the moment of pressing it. Below the fold
              they answer nobody.
            {%- endcomment -%}
            {%- if section.settings.show_payment_icons -%}
              {%- render 'payment-icons', class: 'cart-drawer__payments' -%}
            {%- endif -%}
          </div>

          <div class="cart-drawer__extras">
            {%- if section.settings.show_whatsapp -%}
              {%- render 'cart-whatsapp', class: 'cart-drawer__whatsapp' -%}
            {%- endif -%}
            <div class="cart-drawer__secondary">
              <button class="link cart-drawer__continue" type="button" data-close>{{ 'cart.drawer.continue' | t }}</button>
              {%- if section.settings.show_view_cart -%}
                <a class="link cart-drawer__view-cart" href="{{ routes.cart_url }}">{{ 'cart.drawer.view_cart' | t }}</a>
              {%- endif -%}
            </div>
          </div>
        </form>
      </cart-items>
    {%- else -%}
      <div class="drawer__body cart-drawer__empty">
        {%- render 'icon', name: 'cart', size: 56, class: 'cart-drawer__empty-icon' -%}
        <p class="cart-drawer__empty-title">{{ 'cart.drawer.empty' | t }}</p>
        <p class="cart-drawer__empty-text">{{ 'cart.drawer.empty_text' | t }}</p>
        {%- if pickup_message != blank -%}
          <p class="cart-drawer__empty-note">{{ pickup_message }}</p>
        {%- endif -%}
        <button class="button cart-drawer__empty-button" type="button" data-close>{{ 'cart.drawer.continue' | t }}</button>
        <a class="link" href="{{ routes.all_products_collection_url }}">{{ 'cart.drawer.all_products' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "עגלה צדדית",
  "tag": "div",
  "class": "section-cart-drawer",
  "enabled_on": {
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "הודעת האיסוף, הערת ההזמנה ותיבת האישור לתנאי 90 הימים נקבעות בהגדרות התבנית › עגלה (משותפות לעמוד העגלה)."
    },
    {
      "type": "richtext",
      "id": "conditions",
      "label": "תנאי השריון",
      "default": "<p>ההזמנות באתר הן לשריון ואיסוף עצמי מסניפי JOY Mobile באילת, במחירי אילת ללא מע״מ. האיסוף בהצגת תעודה מזהה, וההזמנה ממתינה בסניף עד 21 ימי עסקים.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_view_cart",
      "label": "קישור לעמוד העגלה",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "סמלי אמצעי תשלום",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_upsell",
      "label": "אביזרים משלימים",
      "info": "אביזרים שמתאימים למכשיר שבעגלה, מתחת לרשימה.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "שריון דרך וואטסאפ",
      "info": "קישור מתחת לכפתור השריון שפותח וואטסאפ עם רשימת המוצרים, הסכום והסניף שנבחר. מוצג רק כשמספר הוואטסאפ מוגדר בהגדרות התבנית.",
      "default": true
    },
    {
      "type": "header",
      "content": "עיצוב הסקשן"
    },
    {
      "type": "paragraph",
      "content": "כל מה שנשאר ריק לוקח את העיצוב הכללי של האתר (הגדרות התבנית › צבעים, טיפוגרפיה)."
    },
    {
      "type": "color_background",
      "id": "ss_background",
      "label": "רקע",
      "info": "צבע אחיד או מעבר צבעים (גרדיאנט)."
    },
    {
      "type": "color",
      "id": "ss_text_color",
      "label": "צבע טקסט"
    },
    {
      "type": "color",
      "id": "ss_heading_color",
      "label": "צבע כותרות"
    },
    {
      "type": "color",
      "id": "ss_accent_color",
      "label": "צבע הדגשה",
      "info": "קישורים, אייקונים ופרטים צבעוניים."
    },
    {
      "type": "color",
      "id": "ss_button_bg",
      "label": "צבע כפתורים"
    },
    {
      "type": "color",
      "id": "ss_button_text",
      "label": "צבע טקסט בכפתורים"
    },
    {
      "type": "range",
      "id": "ss_text_scale",
      "label": "גודל טקסט",
      "min": 80,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "ss_radius",
      "label": "פינות של כפתורים וכרטיסים",
      "options": [
        {
          "value": "theme",
          "label": "כמו בשאר האתר"
        },
        {
          "value": "square",
          "label": "ישרות"
        },
        {
          "value": "soft",
          "label": "מעוגלות מעט"
        },
        {
          "value": "round",
          "label": "מעוגלות"
        },
        {
          "value": "pill",
          "label": "עגולות לגמרי"
        }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "ss_custom_heading_font",
      "label": "פונט אחר לכותרות",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "ss_heading_font",
      "label": "פונט כותרות",
      "info": "לעברית: Assistant, Heebo, Rubik, Noto Sans Hebrew, Frank Ruhl Libre.",
      "default": "assistant_n7",
      "visible_if": "{{ section.settings.ss_custom_heading_font }}"
    },
    {
      "type": "checkbox",
      "id": "ss_custom_body_font",
      "label": "פונט אחר לטקסט",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "ss_body_font",
      "label": "פונט טקסט",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.ss_custom_body_font }}"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "עגלה צדדית"
    }
  ]
}
{% endschema %}
