{%- comment -%}
  "צפיתם לאחרונה": the products this visitor opened before, newest first, as a carousel of product
  cards in the look of sections/related-products (its markup, section-related-products.css and
  carousel.js). The history lives in this browser's localStorage (`joy:recent`, at most 12 handles),
  so <recently-viewed> (assets/recently-viewed.js) builds the carousel:
  - on a product page it records the product (data-handle) after reading the list, so the current
    product is never shown;
  - near the viewport it fetches each card from /products/<handle>?view=card
    (templates/product.card.liquid, as the wishlist page does), four at a time; a deleted or
    renamed product (404 / redirect) is dropped from the list;
  - nothing is shown until at least 2 cards are ready; then the carousel appears at once.
  Without JavaScript or storage nothing is shown. In the theme editor a notice stands in for it.
{%- endcomment -%}
{%- liquid
  assign rv_heading = section.settings.heading | strip
  if rv_heading == blank
    assign rv_heading = 'products.recently_viewed.heading' | t
  endif
  assign rv_heading_id = 'RecentlyViewed-' | append: section.id
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --rp-pad-top: {{ section.settings.padding_top }}px;
    --rp-pad-bottom: {{ section.settings.padding_bottom }}px;
  }

  recently-viewed {
    display: block;
  }
{%- endstyle -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-badges.css' | asset_url | stylesheet_tag }}
{{ 'component-swatches.css' | asset_url | stylesheet_tag }}
{{ 'component-wishlist-button.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'carousel.js' | asset_url }}"></script>
<script type="module" src="{{ 'product.js' | asset_url }}"></script>
<script type="module" src="{{ 'recently-viewed.js' | asset_url }}"></script>

<recently-viewed
  {% if product != blank %}
    data-handle="{{ product.handle | escape }}"
  {% endif %}
  data-limit="{{ section.settings.products_limit }}"
>
  <div class="related-products" data-carousel hidden>
    <div class="related-products__inner">
      <h2 class="related-products__heading" id="{{ rv_heading_id }}">{{ rv_heading | escape }}</h2>
      <carousel-slider
        role="group"
        class="related-products__carousel"
        data-autoplay="0"
        data-loop="false"
        aria-roledescription="{{ 'accessibility.carousel.label' | t }}"
        aria-labelledby="{{ rv_heading_id }}"
      >
        <div class="carousel__track related-products__track" role="list" tabindex="-1" data-track></div>
        <button class="carousel__btn carousel__btn--prev related-products__arrow" type="button" aria-label="{{ 'accessibility.carousel.previous' | t }}">
          {%- render 'icon', name: 'chevron-right', size: 24 -%}
        </button>
        <button class="carousel__btn carousel__btn--next related-products__arrow" type="button" aria-label="{{ 'accessibility.carousel.next' | t }}">
          {%- render 'icon', name: 'chevron-left', size: 24 -%}
        </button>
      </carousel-slider>
    </div>
  </div>

  {%- if request.design_mode -%}
    <div class="related-products related-products--empty" data-editor-notice>
      <div class="related-products__inner">
        <h2 class="related-products__heading">{{ rv_heading | escape }}</h2>
        <p class="related-products__notice">{{ 'products.recently_viewed.editor_empty' | t }}</p>
      </div>
    </div>
  {%- endif -%}
</recently-viewed>

{% schema %}
{
  "name": "צפיתם לאחרונה",
  "tag": "section",
  "class": "section-recently-viewed",
  "disabled_on": {
    "groups": ["header", "aside"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "המוצרים שהמבקר צפה בהם לאחרונה, מהדפדפן שלו. בדף מוצר המוצר נרשם ברשימה ולא מוצג בה. מוצג רק כשיש לפחות שני מוצרים."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "צפיתם לאחרונה"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "מספר מוצרים מרבי",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "ריווח עליון",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "ריווח תחתון",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "צפיתם לאחרונה"
    }
  ]
}
{% endschema %}
